  "findings": [
    {
      "id": "00431-SOURCE",
      "code": "00431",
      "pages": [
        1,
        3,
        6,
        11
      ],
      "severity": "substantive",
      "description": "Current NCCP is v11 (20Aug2026), whereas encoding claimed v10. New HCC indication introduces distinct liver rules, Child-Pugh eligibility, first-maintenance timing and monotherapy duration. Canonical nccp-00431-v10 ID retained as a compatibility identifier; metadata/source version explicitly11. HCC patient service is not marked complete."
    },
    {
      "id": "00431-GRADES",
      "code": "00431",
      "pages": [
        5,
        6,
        7,
        8,
        9
      ],
      "severity": "substantive",
      "description": "Replace generic grade3 hold logic with organ-specific pneumonitis, colitis, hepatitis, nephritis, endocrine, rash, myocarditis and overlap hold/permanent-stop rules. CTCAEv4 is explicitly required by source. Existing generic v5 attribution removed."
    },
    {
      "id": "00431-HISTORY",
      "code": "00431",
      "pages": [
        4,
        5,
        6,
        7,
        8,
        9
      ],
      "severity": "substantive",
      "description": "Add recurrence, refractory-to-steroid, life-threatening, persistent grade2/3, inability-to-taper and SJS/TEN pathways. Recovery/consultant confirmation cannot override permanent stops; both combination components hold together. Myocarditis restart remains specialist uncertainty."
    },
    {
      "id": "00431-SCHEDULE",
      "code": "00431",
      "pages": [
        1,
        2,
        3
      ],
      "severity": "substantive",
      "description": "Encode four21-day induction cycles and four alternative IV/SC maintenance schedules. Melanoma first14-day maintenance waits21days;28-day waits42days. HCC first maintenance waits21days for all alternatives and monotherapy up to24months. Switching14\u219228 waits14days;28\u219214 waits28days. SC existed in sourcev10 but was omitted from old encoding."
    },
    {
      "id": "00431-HCC-LABS",
      "code": "00431",
      "pages": [
        6
      ],
      "severity": "substantive",
      "description": "HCC current AST and ALT each match their own baseline rather than mixing the highest of different enzymes. Normal baseline/current>3\u201310; baseline>1\u20133/current>5\u201310; baseline>3\u20135/current>8\u201310 hold. AST/ALT>10 or bilirubin>3 permanently stops independently of missing baseline. Undefined baseline>5 and missing baseline route to review."
    },
    {
      "id": "00812-GRADES",
      "code": "00812",
      "pages": [
        3,
        4,
        5,
        6
      ],
      "severity": "substantive",
      "description": "Add recurrent grade2 pneumonitis stop; first grade3 colitis hold versus recurrence stop; grade3 nephritis stop; bilirubin>3 stop; skin>1week boundary; SJS/TEN suspicion versus confirmation; idelalisib history; neurological/carditis/HLH and infusion rules."
    },
    {
      "id": "00812-ENDOCRINE",
      "code": "00812",
      "pages": [
        3,
        4,
        5
      ],
      "severity": "substantive",
      "description": "Preserve endocrine exceptions: grade3\u20134 thyroid/thyroiditis/diabetes and grade2\u20134 pituitary/adrenal are held with possible resumption after grade0\u20131 or clinical stability. Generic grade4 and persistent12-week non-endocrine stop rows must not erase the exceptions. Source specifies current CTCAE without naming an edition."
    },
    {
      "id": "00812-TAPER",
      "code": "00812",
      "pages": [
        3,
        4,
        5
      ],
      "severity": "substantive",
      "description": "Add organ-specific sustained recovery and steroid\u226410mg/day taper gates, persistent grade2/3\u226512weeks excluding endocrine, and steroid>10mg/day at12weeks permanent-stop criteria. The source does not give00431 a12-week grace period; rules remain separate."
    },
    {
      "id": "00812-INDICATION",
      "code": "00812",
      "pages": [
        1,
        2
      ],
      "severity": "substantive",
      "description": "Retain cervical post-platinum indication separately from advanced CSCC. Measurable disease and transplant caution belong to CSCC; post-platinum requirement belongs to cervical. Adjuvant CSCC is not in this NCCPv3a and is not added."
    },
    {
      "id": "BOTH-BASELINE",
      "code": "both",
      "pages": "00431pp3,9;00812pp1\u20133",
      "severity": "substantive",
      "description": "Distinguish baseline organ impairment (no routine reduction) from treatment-emergent immune toxicity. Do not use a creatinine baseline-or-ULN ratio to invent a CTCAE nephritis grade. Blood counts/endocrine tests remain context where source gives no standalone dosing threshold."
    }
  ],
