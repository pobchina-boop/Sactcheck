    "reference_text_sha256": "4b79d8baa2c9899e33bb90a2e3f365fdef2fb57fc788d2b2660c7d9e07adddee",
    "retrospective_focus": "The first postoperative cycle uses paclitaxel and carboplatin. The team checks wound healing before adding bevacizumab from cycle 2."
  },
  "00499": {
    "url": "https://healthservice.hse.ie/documents/6507/499_V8_GemCARBOAUC_4BEV.pdf",
    "version": "8",
    "source_checked": "2026-11-26",
