    "reference_text_sha256": "89074959f1c984110eaf8bc08e0b5b36d5af903f3b36af77c6214335d1db1a02",
    "retrospective_focus": "Tell the team about previous pelvic radiotherapy. Call urgently for new pelvic pain, bleeding, or leakage of urine or stool through the vagina."
  },
  "00817": {
    "url": "https://healthservice.hse.ie/documents/6429/Pembro_Pac_175_Carbo_AUC_5_817_.pdf",
    "version": "3",
    "source_checked": "2026-11-26",
    "scope": "retrospective review",
    "reference_text_sha256": "ee5574a3364044112f69ff7c84dbd0d662684deca53da9851b33b999d5ec951d",
    "retrospective_focus": "Keep your immunotherapy card. Call the oncology team about new cough, diarrhoea, marked fatigue or thirst even after the last infusion."
  },
  "00799": {
    "url": "https://healthservice.hse.ie/documents/6422/799_V2_Bev_Pacli_CIS.pdf",
    "version": "2",
    "source_checked": "2026-11-26",
    "scope": "retrospective review",
    "reference_text_sha256": "f9f2617671ba84b9e09b41429435739ca3337e8a39ac3b0d55452136775d9420",
    "retrospective_focus": "Tell the team about ringing in your ears, hearing changes, reduced urine, or difficulty keeping fluids down. Ask how these affect the next infusion."
  },
  "00766": {
    "url": "https://healthservice.hse.ie/documents/6667/766_V2_Bevacizumab_15_Paclitaxel_CarboplatinAUC6.pdf",
    "version": "2",
