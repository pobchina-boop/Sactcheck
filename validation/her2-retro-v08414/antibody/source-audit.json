  "proposed_changes": {
    "00200": {
      "new_rules": [
        {
          "rule_id": "INFUSION_REACTION_G1_G2",
          "when": {
            "all": [
              {
                "field": "hypersensitivity_grade",
                "operator": ">=",
                "value": 1
              },
              {
                "field": "hypersensitivity_grade",
                "operator": "<=",
                "value": 2
              }
            ]
          },
          "action": {
            "type": "withhold",
            "components": [
              "trastuzumab"
            ],
            "recommendation": "Pause or slow the infusion and assess the reaction. Provide appropriate treatment and observe until symptoms resolve; restart requires the treating team’s decision."
          },
          "explanation": "Pause or slow the infusion and assess the reaction. Provide appropriate treatment and observe until symptoms resolve; restart requires the treating team’s decision.",
          "source": {
            "document": "NCCP 00200 v8",
            "url": "https://healthservice.hse.ie/documents/6330/200_Trastuzumab_21days_Ubeecpc.pdf",
            "page": 5
          }
        },
        {
          "rule_id": "SEVERE_REACTION_G3",
          "when": {
            "field": "hypersensitivity_grade",
            "operator": "==",
            "value": 3
          },
          "action": {
            "type": "withhold",
            "components": [
              "trastuzumab"
            ],
            "recommendation": "Stop the infusion and urgently treat the serious reaction. Re-exposure requires specialist review; grade 3 alone is not a rule for permanent cessation."
          },
          "explanation": "Stop the infusion and urgently treat the serious reaction. Re-exposure requires specialist review; grade 3 alone is not a rule for permanent cessation.",
