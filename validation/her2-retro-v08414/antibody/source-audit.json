    "00726": {
      "new_input_definitions": {
        "treatment_setting": {
          "label": "Treatment setting",
          "type": "select",
          "required": false,
          "input_role": "context",
          "options": [
            {
              "value": "metastatic",
              "label": "Metastatic / locally recurrent unresectable"
            },
            {
              "value": "early",
              "label": "Early breast cancer"
            }
          ],
          "demo_value": "metastatic"
        },
        "indication_eligible": {
          "label": "Full NCCP maintenance indication confirmed",
          "type": "boolean",
          "required": false,
          "input_role": "decision",
          "demo_value": false
        },
        "chemotherapy_component_completed": {
          "label": "Preceding chemotherapy with pertuzumab/trastuzumab completed",
          "type": "boolean",
          "required": false,
          "input_role": "decision",
          "demo_value": false
        },
        "disease_progression": {
          "label": "Disease progression on current treatment",
          "type": "boolean",
          "required": false,
          "input_role": "decision",
          "demo_value": false
        },
        "cardiac_monitoring_overdue": {
          "label": "Required echo / MUGA result overdue or unavailable",
          "type": "boolean",
          "required": false,
          "input_role": "decision",
          "demo_value": false
        },
        "prolonged_diarrhoea": {
          "label": "Prolonged diarrhoea despite supportive treatment",
          "type": "boolean",
          "required": false,
          "input_role": "decision",
          "demo_value": false
        },
        "concurrent_anthracycline": {
          "label": "Concurrent anthracycline planned",
          "type": "boolean",
          "required": false,
          "input_role": "decision",
          "demo_value": false
        }
      },
      "new_rules": [
        {
          "rule_id": "MAINTENANCE_SETTING_REVIEW",
          "when": {
            "field": "treatment_setting",
            "operator": "==",
            "value": "early"
          },
          "action": {
            "type": "consultant_review",
            "components": [
              "pertuzumab",
              "trastuzumab"
            ],
            "recommendation": "This NCCP maintenance card is for metastatic or locally recurrent unresectable disease; use the relevant early-breast pathway."
          },
          "explanation": "This NCCP maintenance card is for metastatic or locally recurrent unresectable disease; use the relevant early-breast pathway.",
          "source": {
            "document": "NCCP 00726 v3a",
            "url": "https://healthservice.hse.ie/documents/6599/726_v3a_Pertuzumab_trastuzumab.pdf",
            "page": 1
          }
        },
        {
          "rule_id": "MAINTENANCE_INDICATION_REVIEW",
          "when": {
            "field": "indication_eligible",
            "operator": "==",
            "value": false
          },
          "action": {
            "type": "consultant_review",
            "components": [
              "pertuzumab",
              "trastuzumab"
            ],
            "recommendation": "Confirm the complete maintenance indication and preceding pertuzumab/trastuzumab chemotherapy strategy before selecting this card."
          },
          "explanation": "Confirm the complete maintenance indication and preceding pertuzumab/trastuzumab chemotherapy strategy before selecting this card.",
          "source": {
            "document": "NCCP 00726 v3a",
            "url": "https://healthservice.hse.ie/documents/6599/726_v3a_Pertuzumab_trastuzumab.pdf",
            "page": 1
          }
        },
        {
          "rule_id": "CHEMOTHERAPY_COMPLETION_REVIEW",
          "when": {
            "field": "chemotherapy_component_completed",
            "operator": "==",
            "value": false
          },
          "action": {
            "type": "consultant_review",
            "components": [
              "pertuzumab",
              "trastuzumab"
            ],
            "recommendation": "The chemotherapy component has not been completed. Review the active combination protocol; this card describes antibody-only continuation."
          },
          "explanation": "The chemotherapy component has not been completed. Review the active combination protocol; this card describes antibody-only continuation.",
          "source": {
            "document": "NCCP 00726 v3a",
            "url": "https://healthservice.hse.ie/documents/6599/726_v3a_Pertuzumab_trastuzumab.pdf",
            "page": 1
          }
        },
        {
          "rule_id": "PROGRESSION_REVIEW",
          "when": {
            "field": "disease_progression",
            "operator": "==",
            "value": true
          },
          "action": {
            "type": "consultant_review",
            "components": [
              "pertuzumab",
              "trastuzumab"
            ],
            "recommendation": "Progression requires reassessment of the treatment strategy; do not automatically continue this maintenance plan."
          },
          "explanation": "Progression requires reassessment of the treatment strategy; do not automatically continue this maintenance plan.",
          "source": {
            "document": "NCCP 00726 v3a",
            "url": "https://healthservice.hse.ie/documents/6599/726_v3a_Pertuzumab_trastuzumab.pdf",
            "page": 1
          }
        },
        {
          "rule_id": "ECHO_UNAVAILABLE",
          "when": {
            "field": "cardiac_monitoring_overdue",
            "operator": "==",
            "value": true
          },
          "action": {
            "type": "consultant_review",
            "components": [
              "pertuzumab",
              "trastuzumab"
            ],
            "recommendation": "Obtain the required cardiac result and a documented specialist decision before the next administration; do not assume normal function."
          },
          "explanation": "Obtain the required cardiac result and a documented specialist decision before the next administration; do not assume normal function.",
          "source": {
            "document": "NCCP 00726 v3a",
            "url": "https://healthservice.hse.ie/documents/6599/726_v3a_Pertuzumab_trastuzumab.pdf",
            "page": 2
          }
        },
        {
          "rule_id": "UNCONTROLLED_HYPERTENSION_REVIEW",
          "when": {
            "field": "uncontrolled_hypertension",
            "operator": "==",
            "value": true
          },
          "action": {
            "type": "consultant_review",
            "components": [
              "pertuzumab",
              "trastuzumab"
            ],
            "recommendation": "Uncontrolled hypertension is a cardiac-risk context not studied in the pertuzumab population described by NCCP. Assess and optimise cardiovascular status before deciding to continue."
          },
          "explanation": "Uncontrolled hypertension is a cardiac-risk context not studied in the pertuzumab population described by NCCP. Assess and optimise cardiovascular status before deciding to continue.",
          "source": {
            "document": "NCCP 00726 v3a",
            "url": "https://healthservice.hse.ie/documents/6599/726_v3a_Pertuzumab_trastuzumab.pdf",
            "page": 5
          }
        },
        {
          "rule_id": "PROLONGED_DIARRHOEA_NOT_IMPROVING",
          "when": {
            "all": [
              {
                "field": "prolonged_diarrhoea",
                "operator": "==",
                "value": true
              },
              {
                "field": "diarrhoea_not_improving",
                "operator": "==",
                "value": true
              }
            ]
          },
          "action": {
            "type": "withhold",
            "components": [
              "pertuzumab"
            ],
            "recommendation": "Consider interrupting pertuzumab for prolonged diarrhoea that has not improved with supportive treatment. Review hydration and electrolytes; resume only after symptoms are controlled."
          },
          "explanation": "Consider interrupting pertuzumab for prolonged diarrhoea that has not improved with supportive treatment. Review hydration and electrolytes; resume only after symptoms are controlled.",
          "source": {
            "document": "NCCP 00726 v3a",
            "url": "https://healthservice.hse.ie/documents/6599/726_v3a_Pertuzumab_trastuzumab.pdf",
            "page": 5
          }
        },
        {
          "rule_id": "ANTHRACYCLINE_OVERLAP",
          "when": {
            "field": "concurrent_anthracycline",
            "operator": "==",
            "value": true
          },
          "action": {
            "type": "withhold",
            "components": [
              "pertuzumab",
              "trastuzumab"
            ],
            "recommendation": "Do not administer concurrent anthracycline with this HER2-antibody maintenance card; review the complete regimen and cardiac risk."
          },
          "explanation": "Do not administer concurrent anthracycline with this HER2-antibody maintenance card; review the complete regimen and cardiac risk.",
          "source": {
            "document": "NCCP 00726 v3a",
            "url": "https://healthservice.hse.ie/documents/6599/726_v3a_Pertuzumab_trastuzumab.pdf",
            "page": 5
          }
        }
      ],
      "do_not_make_required": [
        "treatment_setting",
        "indication_eligible",
        "chemotherapy_component_completed",
        "disease_progression",
        "cardiac_monitoring_overdue",
        "prolonged_diarrhoea",
        "concurrent_anthracycline"
      ],
      "preserve_existing_cardiac_and_reload_rules": true
    }
  },
