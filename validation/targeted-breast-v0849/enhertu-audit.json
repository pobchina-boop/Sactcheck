        "checked_date": "2026-10-20",
        "source_id": "nccp-00776",
        "supplemental_sources": [
          {
            "document": "EMA Enhertu product information",
            "url": "https://www.ema.europa.eu/en/documents/product-information/enhertu-epar-product-information_en.pdf",
            "page": 6,
            "checked_date": "2026-10-20",
            "source_id": "ema-enhertu",
            "section": "4.2"
          }
        ]
      },
      "action": "proceed_with_caution",
      "decision": "CrCl 30–<60 mL/min: no renal dose adjustment is required. EMA reports higher Grade 1–2 ILD incidence with moderate impairment; monitor carefully for respiratory symptoms and other toxicity."
    },
    {
      "id": "RENAL_SEVERE",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 3,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776",
        "supplemental_sources": [
          {
            "document": "EMA Enhertu product information",
            "url": "https://www.ema.europa.eu/en/documents/product-information/enhertu-epar-product-information_en.pdf",
            "page": 6,
            "checked_date": "2026-10-20",
            "source_id": "ema-enhertu",
            "section": "4.2"
          }
        ]
      },
      "action": "consultant_review",
      "decision": "NCCP expects no renal adjustment at CrCl<30 mL/min, but EMA says dose requirements cannot be determined because data are lacking. Reconcile with oncology/pharmacy; no automatic dose recommendation. Monitor carefully, especially for ILD."
    },
    {
      "id": "RENAL_DIALYSIS",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
