        "page": 1,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "permanently_discontinue",
      "decision": "Permanently discontinue for a severe infusion-related reaction."
    },
    {
      "id": "ILD_G2PLUS",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776",
        "supplemental_sources": [
          {
            "document": "EMA Enhertu product information",
            "url": "https://www.ema.europa.eu/en/documents/product-information/enhertu-epar-product-information_en.pdf",
            "page": 7,
            "checked_date": "2026-10-20",
            "source_id": "ema-enhertu",
            "section": "4.4"
          }
        ]
      },
      "action": "permanently_discontinue",
      "decision": "Permanently discontinue for symptomatic Grade ≥2 ILD/pneumonitis. Promptly initiate corticosteroids under specialist care (EMA example: prednisolone ≥1 mg/kg/day or equivalent for at least 14 days, then taper for at least 4 weeks). Do not rechallenge after symptomatic ILD."
    },
    {
      "id": "ILD_G1_LONG",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "dose_reduce_one_level",
      "decision": "Previous Grade 1 ILD took >28 days to resolve: after confirmation of Grade 0, reduce one dose level. No re-escalation; if already at 3.2 mg/kg, discontinue."
    },
    {
      "id": "ILD_G1",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776",
        "supplemental_sources": [
          {
            "document": "EMA Enhertu product information",
            "url": "https://www.ema.europa.eu/en/documents/product-information/enhertu-epar-product-information_en.pdf",
            "page": 7,
            "checked_date": "2026-10-20",
            "source_id": "ema-enhertu",
            "section": "4.4"
          }
        ]
      },
      "action": "withhold",
      "decision": "Withhold for asymptomatic Grade 1 ILD until Grade 0. Consider corticosteroids promptly (EMA example: prednisolone ≥0.5 mg/kg/day or equivalent); investigate with CT and respiratory input. If resolved within 28 days resume same dose; if >28 days reduce one level. These are clinician instructions, not a patient self-treatment plan."
    },
    {
      "id": "ANC_G4",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "withhold_then_reduce",
      "decision": "Withhold for ANC<0.5 ×10⁹/L until ANC≥1.0 (Grade ≤2), then reduce one dose level. If already at 3.2 mg/kg and further reduction is required, discontinue."
    },
    {
      "id": "ANC_G3",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "withhold",
      "decision": "Withhold for ANC 0.5 to <1.0 ×10⁹/L until ANC≥1.0 (Grade ≤2), then maintain the current dose. Assess fever/infection separately."
    },
    {
      "id": "FEBRILE_NEUTROPENIA_383",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "withhold_then_reduce",
      "decision": "Febrile neutropenia criterion met: interrupt until resolved, then reduce one dose level. Arrange urgent clinical assessment and manage suspected neutropenic sepsis under local policy; do not wait for a threshold-duration test to seek help."
    },
    {
      "id": "FEBRILE_NEUTROPENIA_38",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "withhold_then_reduce",
      "decision": "Febrile neutropenia criterion met: ANC <1.0 with temperature ≥38°C sustained >1 hour; interrupt until resolved, then reduce one dose level. Arrange urgent clinical assessment and manage suspected neutropenic sepsis under local policy; do not wait for a threshold-duration test to seek help."
    },
    {
      "id": "CHF",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "permanently_discontinue",
      "decision": "Permanently discontinue for symptomatic congestive heart failure."
    },
    {
      "id": "LVEF_LT40",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "withhold",
      "decision": "Interrupt for LVEF <40%; repeat within 3 weeks. If confirmed, permanently discontinue."
    },
    {
      "id": "LVEF_DROP_GT20",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "withhold",
      "decision": "Interrupt for an absolute LVEF decrease >20 percentage points; repeat within 3 weeks and permanently discontinue if confirmed."
    },
    {
      "id": "LVEF_40_45_DROP10",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "withhold",
      "decision": "LVEF 40-45% with a 10-20 point fall: interrupt and repeat within 3 weeks; discontinue if not recovered to within 10 points of baseline."
    },
    {
      "id": "LVEF_40_45_SMALLDROP",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "proceed_with_caution",
      "decision": "LVEF 40-45% with <10 point fall: treatment may continue; repeat LVEF within 3 weeks."
    },
    {
      "id": "LVEF_GT45_DROP10",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "proceed_with_caution",
      "decision": "LVEF >45% with a 10-20 point fall: continue treatment with cardiac surveillance."
    },
    {
      "id": "SEVERE_HEPATIC",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 3,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "contraindicated",
      "decision": "Severe hepatic impairment: trastuzumab deruxtecan is not recommended."
    },
    {
      "id": "MOD_HEPATIC",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 3,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776",
        "supplemental_sources": [
          {
            "document": "EMA Enhertu product information",
            "url": "https://www.ema.europa.eu/en/documents/product-information/enhertu-epar-product-information_en.pdf",
            "page": 6,
            "checked_date": "2026-10-20",
            "source_id": "ema-enhertu",
            "section": "4.2"
          }
        ]
      },
      "action": "consultant_review",
      "decision": "NCCP expects no adjustment for moderate hepatic impairment with close toxicity monitoring. EMA states that dose requirements with bilirubin>1.5×ULN cannot be determined due to limited data. Reconcile the category and source difference with oncology/pharmacy; do not calculate a dose automatically."
    },
    {
      "id": "FURTHER_REDUCTION",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 3,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "permanently_discontinue",
      "decision": "A further reduction below 3.2 mg/kg is required: permanently discontinue. Do not re-escalate following a reduction."
    },
    {
      "id": "ILD_G1_RESOLVED_28",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "proceed_with_caution",
      "decision": "Previous Grade 1 ILD resolved within 28 days: after confirming complete Grade 0 recovery and no prior symptomatic ILD, the same dose may resume. Continue pulmonary surveillance; all other domains remain to be assessed."
    },
    {
      "id": "ILD_SUSPECTED",
      "source": {
        "document": "EMA Enhertu product information",
        "url": "https://www.ema.europa.eu/en/documents/product-information/enhertu-epar-product-information_en.pdf",
        "page": 7,
        "checked_date": "2026-10-20",
        "source_id": "ema-enhertu"
      },
      "action": "withhold",
      "decision": "Withhold while suspected ILD/pneumonitis is urgently evaluated. Arrange radiographic investigation, preferably CT, consider respiratory consultation and corticosteroids according to grade. Do not wait for the next routine scan."
    },
    {
      "id": "ILD_PREVIOUS_SYMPTOMATIC",
      "source": {
        "document": "EMA Enhertu product information",
        "url": "https://www.ema.europa.eu/en/documents/product-information/enhertu-epar-product-information_en.pdf",
        "page": 7,
        "checked_date": "2026-10-20",
        "source_id": "ema-enhertu"
      },
      "action": "permanently_discontinue",
      "decision": "Prior symptomatic Grade ≥2 treatment-related ILD prohibits rechallenge even if symptoms/imaging have subsequently resolved."
    },
    {
      "id": "BASELINE_LVEF_LT50",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 2,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "withhold",
      "decision": "Do not initiate automatically: baseline LVEF<50% does not meet NCCP eligibility. Obtain oncology/cardiology review; ongoing-treatment continuation rules must not be applied to first-dose eligibility."
    },
    {
      "id": "LVEF_CONFIRMED_SEVERE",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "permanently_discontinue",
      "decision": "Repeat LVEF confirms <40% or an absolute fall >20 percentage points: permanently discontinue."
    },
    {
      "id": "LVEF_RECHECK_NOT_RECOVERED",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "permanently_discontinue",
      "decision": "After initial LVEF 40–45% with10–20-point fall, repeat within 3 weeks has not recovered to within 10 points of baseline: permanently discontinue."
    },
    {
      "id": "LVEF_RECHECK_RECOVERED",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 4,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "proceed_with_caution",
      "decision": "After the specified initial LVEF 40–45%/10–20-point decline and treatment interruption, recovery to within 10 points permits same-dose resumption following clinical review. This pathway does not override confirmed severe dysfunction or symptomatic CHF."
    },
    {
      "id": "RENAL_GE60",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 3,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "proceed_with_caution",
      "decision": "CrCl≥60 mL/min: no renal dose adjustment is required under NCCP. This assesses the renal domain only."
    },
    {
      "id": "RENAL_MODERATE",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
