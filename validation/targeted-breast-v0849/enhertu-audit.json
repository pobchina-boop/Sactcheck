        "source_id": "nccp-00776"
      },
      "action": "consultant_review",
      "decision": "NCCP eligibility literally specifies age>18years while the indication/EMA says adults. Patients aged18 need source-boundary reconciliation; younger patients are outside this adult regimen."
    },
    {
      "id": "ECOG_OUTSIDE",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
        "page": 1,
        "checked_date": "2026-10-20",
        "source_id": "nccp-00776"
      },
      "action": "consultant_review",
      "decision": "ECOG>2 is outside NCCP eligibility; consultant review is required."
    },
    {
      "id": "HER2_OUTSIDE",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
