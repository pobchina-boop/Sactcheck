            "checked_date": "2026-10-20",
            "source_id": "ema-enhertu",
            "section": "4.2"
          }
        ]
      },
      "action": "consultant_review",
      "decision": "NCCP expects no dialysis adjustment; EMA cannot determine dosing in end-stage renal disease. Obtain specialist/pharmacy review and close toxicity/ILD monitoring; no numeric recommendation is inferred."
    },
    {
      "id": "AGE_SOURCE_BOUNDARY",
      "source": {
        "document": "NCCP00776 v3b (21 May 2026)",
        "url": "https://healthservice.hse.ie/documents/6661/Trastuzumab_776_Deruxtecan_5.4mg_Therapy.pdf",
