[
  {
    "rule_id": "EXCLUSION_HYPERSENSITIVITY",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 2,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "hypersensitivity",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "contraindicated",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Do not administer bevacizumab with relevant bevacizumab, excipient, CHO-product or recombinant-antibody hypersensitivity; consultant review required."
    }
  },
  {
    "rule_id": "PREGNANCY_REVIEW",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 2,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "pregnancy",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "contraindicated",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Do not administer bevacizumab during pregnancy; urgent consultant review is required."
    }
  },
  {
    "rule_id": "BREASTFEEDING",
    "source": {
      "document": "EMA Avastin product information",
      "url": "https://www.ema.europa.eu/en/documents/product-information/avastin-epar-product-information_en.pdf",
      "page": 10,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "breastfeeding",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "contraindicated",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Do not breastfeed during bevacizumab treatment or for at least six months after the final dose. Obtain consultant advice before treatment."
    }
  },
  {
    "rule_id": "ADULT_INDICATION",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 1,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "age_years",
      "operator": "<",
      "value": 18
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "NCCP indication is for adults; paediatric use is outside this mapped component."
    }
  },
  {
    "rule_id": "ECOG_OVER_2",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 2,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "ecog",
      "operator": ">",
      "value": 2
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "ECOG above 2 is outside NCCP eligibility; consultant assessment is required."
    }
  },
  {
    "rule_id": "PARTNER_UNCONFIRMED",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 1,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "indication_partner_confirmed",
      "operator": "==",
      "value": false
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Confirm the indication-specific partner and any permitted continuation plan before treatment; this component is not an unrestricted bevacizumab monotherapy regimen."
    }
  },
  {
    "rule_id": "COMBINATION_SCOPE_GAP",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 1,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "treatment_context",
          "operator": "==",
          "value": "combination"
        },
        {
          "field": "partner_sact_assessed_separately",
          "operator": "==",
          "value": false
        }
      ]
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Complete assessment and prescribing review of every partner SACT medicine; this assessment evaluates bevacizumab only."
    }
  },
  {
    "rule_id": "MONOTHERAPY_SCOPE",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 1,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "treatment_context",
      "operator": "==",
      "value": "bevacizumab_only"
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Confirm a permitted continuation indication and a consultant plan. Breast use in this NCCP regimen is with paclitaxel; trial allowance for early chemotherapy discontinuation does not establish a new unrestricted breast monotherapy indication."
    }
  },
  {
    "rule_id": "BREAST_HER2_SCOPE",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 1,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "indication_id",
          "operator": "==",
          "value": "metastatic_breast"
        },
        {
          "field": "breast_her2_negative",
          "operator": "==",
          "value": false
        }
      ]
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Mapped breast indication requires HER2-negative metastatic disease with paclitaxel; HER2-positive or unresolved testing requires indication review."
    }
  },
  {
    "rule_id": "FIRST_LINE_SCOPE",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 1,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "indication_id",
          "operator": "in",
          "value": [
            "metastatic_breast",
            "advanced_renal"
          ]
        },
        {
          "field": "first_line_metastatic",
          "operator": "==",
          "value": false
        }
      ]
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "This selected indication is a first-line regimen; confirm the approved setting and individual plan."
    }
  },
  {
    "rule_id": "OVARIAN_PRIOR_LINES",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 1,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "indication_id",
          "operator": "==",
          "value": "platinum_resistant_ovarian"
        },
        {
          "field": "prior_chemotherapy_regimens",
          "operator": ">",
          "value": 2
        }
      ]
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Platinum-resistant ovarian/fallopian/peritoneal indication requires no more than two prior chemotherapy regimens and no prior bevacizumab/VEGF/VEGFR treatment."
    }
  },
  {
    "rule_id": "OVARIAN_PRIOR_VEGF",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 1,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "indication_id",
          "operator": "==",
          "value": "platinum_resistant_ovarian"
        },
        {
          "field": "prior_vegf_therapy",
          "operator": "==",
          "value": true
        }
      ]
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Platinum-resistant ovarian/fallopian/peritoneal indication requires no more than two prior chemotherapy regimens and no prior bevacizumab/VEGF/VEGFR treatment."
    }
  },
  {
    "rule_id": "HIGH_RISK_HISTORY",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 2,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "high_risk_history",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Review the specific bleeding, clotting, cardiovascular, renal/proteinuria, radiotherapy, fistula or perforation risk before treatment. A caution is not automatically an absolute exclusion. Include aneurysm/dissection history and intra-abdominal inflammation."
    }
  },
  {
    "rule_id": "RECENT_HAEMOPTYSIS",
    "source": {
      "document": "EMA Avastin product information",
      "url": "https://www.ema.europa.eu/en/documents/product-information/avastin-epar-product-information_en.pdf",
      "page": 7,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "recent_haemoptysis_over_2_5_ml",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "contraindicated",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "EMA states that patients with recent pulmonary haemorrhage/haemoptysis exceeding 2.5 mL red blood should not receive bevacizumab; urgent specialist review."
    }
  },
  {
    "rule_id": "SUNITINIB_INTERACTION",
    "source": {
      "document": "Supplementary current NCCP00214 v8 (interaction text absent from00212 v7)",
      "url": "https://healthservice.hse.ie/documents/6554/214_Bevacizumab_7.5.pdf",
      "page": 6,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05",
      "version": "8"
    },
    "condition": {
      "field": "sunitinib_concurrent",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Concurrent sunitinib increases risk of microangiopathic haemolytic anaemia; review and avoid an unassessed combination."
    }
  },
  {
    "rule_id": "EGFR_ANTIBODY_INTERACTION",
    "source": {
      "document": "Supplementary current NCCP00214 v8 (interaction text absent from00212 v7)",
      "url": "https://healthservice.hse.ie/documents/6554/214_Bevacizumab_7.5.pdf",
      "page": 6,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05",
      "version": "8"
    },
    "condition": {
      "field": "egfr_antibody_with_chemo",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "withhold",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Do not administer panitumumab or cetuximab with bevacizumab-containing chemotherapy for metastatic colorectal cancer. Review and correct the entire combination with the consultant; this component assessment does not independently prescribe the partner regimen."
    }
  },
  {
    "rule_id": "UNHEALED_WOUND_OR_RECENT_SURGERY",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 5,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "recent_major_surgery_or_unhealed_wound",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "withhold",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Withhold bevacizumab for recent major surgery or an unhealed wound: at least 28 days after major surgery AND full wound healing are required before starting; review any treatment-emergent wound complication."
    }
  },
  {
    "rule_id": "MAJOR_SURGERY_LT28",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 5,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "days_since_major_surgery",
      "operator": "<",
      "value": 28
    },
    "action": {
      "type": "withhold",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Do not initiate bevacizumab within 28 days after major surgery; at least 28 days AND full wound healing are required."
    }
  },
  {
    "rule_id": "WOUND_NOT_HEALED",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 5,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "wound_fully_healed",
      "operator": "==",
      "value": false
    },
    "action": {
      "type": "withhold",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Withhold bevacizumab until the surgical wound is fully healed, even if the 28-day interval has elapsed."
    }
  },
  {
    "rule_id": "PLANNED_MAJOR_SURGERY",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 5,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "planned_major_surgery",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "withhold",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Withhold for elective major surgery for 28 days or according to the prescribing consultant plan; agree timing and wound reassessment."
    }
  },
  {
    "rule_id": "PLANNED_MINOR_SURGERY",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 5,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "planned_minor_surgery",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "withhold",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Withhold for minor surgery for 7 days or according to the prescribing consultant plan; agree timing and wound reassessment."
    }
  },
  {
    "rule_id": "UNCONTROLLED_HYPERTENSION",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 4,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "uncontrolled_or_symptomatic_hypertension",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "withhold",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Withhold bevacizumab for uncontrolled or symptomatic hypertension; start or adjust antihypertensive treatment."
    }
  },
  {
    "rule_id": "PERSISTENT_G3_HYPERTENSION",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 4,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "hypertension_grade",
          "operator": "==",
          "value": 3
        },
        {
          "field": "hypertension_persisting",
          "operator": "==",
          "value": true
        }
      ]
    },
    "action": {
      "type": "discontinue",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Discontinue bevacizumab for persisting grade 3 hypertension."
    }
  },
  {
    "rule_id": "G4_HYPERTENSION",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 4,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "hypertension_grade",
      "operator": "==",
      "value": 4
    },
    "action": {
      "type": "discontinue",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Discontinue bevacizumab for grade 4 hypertension."
    }
  },
  {
    "rule_id": "G2_G3_BP_REVIEW",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 4,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "hypertension_grade",
      "operator": "in",
      "value": [
        2,
        3
      ]
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Start or optimise antihypertensive therapy. For grade 2–3 hypertension, consider interruption until controlled. Grade 3 alone does not establish persistence; persisting grade 3 or grade 4 requires discontinuation."
    }
  },
  {
    "rule_id": "SEVERE_UNCONTROLLED_BP",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 6,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "severe_bp_uncontrolled",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "discontinue",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Discontinue bevacizumab for clinically confirmed severe BP >200/110 mmHg that remains uncontrolled with medication."
    }
  },
  {
    "rule_id": "HYPERTENSIVE_CRISIS_PRES",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 6,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "hypertensive_crisis_or_encephalopathy",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "permanently_discontinue",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Permanently discontinue bevacizumab and manage hypertensive crisis or encephalopathy urgently."
    }
  },
  {
    "rule_id": "PROTEIN_DIPSTICK_2_3",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 4,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "proteinuria_dipstick",
          "operator": "in",
          "value": [
            "2+",
            "3+"
          ]
        },
        {
          "field": "urine_protein_g_24h",
          "operator": "missing",
          "value": true
        }
      ]
    },
    "action": {
      "type": "proceed_with_caution",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "For the proteinuria domain only, a 2+/3+ dipstick permits scheduled bevacizumab while collecting a 24-hour urine total protein within 3 days before the next dose. Apply any quantified result and all other safety findings."
    }
  },
  {
    "rule_id": "PROTEIN_LAB_GE1",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 4,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "urine_protein_g_l",
          "operator": ">=",
          "value": 1
        },
        {
          "field": "urine_protein_g_24h",
          "operator": "missing",
          "value": true
        }
      ]
    },
    "action": {
      "type": "proceed_with_caution",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "For the proteinuria domain only, spot urine protein ≥1 g/L requires a 24-hour total protein collection within 3 days before the next dose; the source permits the scheduled dose if no other hold criterion applies. g/L is not g/24 h."
    }
  },
  {
    "rule_id": "PROTEIN_DIPSTICK_4",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 4,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "proteinuria_dipstick",
          "operator": "==",
          "value": "4+"
        },
        {
          "field": "urine_protein_g_24h",
          "operator": "missing",
          "value": true
        }
      ]
    },
    "action": {
      "type": "withhold",
      "components": [
        "bevacizumab"
      ],
      "recommendation": "Withhold bevacizumab for 4+ dipstick pending 24-hour urine total protein; subsequently apply the quantified result."
    }
  },
  {
    "rule_id": "PROTEIN_LE2",
    "source": {
      "document": "NCCP 00212 version 7",
      "url": "https://healthservice.hse.ie/documents/6552/212_Bevacizumab_10.pdf",
      "page": 4,
      "checked": "2026-11-05",
      "checked_date": "2026-11-05"
    },
    "condition": {
      "field": "urine_protein_g_24h",
      "operator": "<=",
