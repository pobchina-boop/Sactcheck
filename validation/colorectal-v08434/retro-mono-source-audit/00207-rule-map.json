  },
  {
    "rule_id": "PREGNANCY_LACTATION",
    "source": {
      "document": "Erbitux EMA product information (supplementary)",
      "page": "4.2–4.6",
      "url": "https://www.ema.europa.eu/en/documents/product-information/erbitux-epar-product-information_en.pdf",
      "checked_date": "2026-11-05",
      "checked": "2026-11-05"
    },
    "condition": {
      "any": [
        {
          "field": "pregnancy",
          "operator": "==",
          "value": true
        },
        {
          "field": "breastfeeding",
          "operator": "==",
          "value": true
        }
      ]
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "cetuximab"
      ],
      "recommendation": "Pregnancy or breastfeeding requires specialist review; do not give routine treatment clearance. Follow the medicine-specific pregnancy, contraception and breastfeeding precautions.",
      "show_in_dose_actions": true,
      "dose_calculation": "specialist_review"
    }
  },
  {
    "rule_id": "INDICATION_CONTEXT",
    "source": {
      "document": "NCCP 00207 v6",
      "page": 1,
      "url": "https://healthservice.hse.ie/documents/6941/207_Cetuximab_7day_.pdf",
      "checked_date": "2026-11-05",
      "checked": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "indication_id",
          "operator": "missing"
        },
        {
          "field": "ras_status",
          "operator": "in",
          "value": [
            "wild_type",
            "mutant",
            "unknown"
          ]
        }
      ]
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "cetuximab"
      ],
      "recommendation": "00207 has two indications. Confirm colorectal versus head/neck with radiotherapy; RAS selection applies to colorectal cancer only. This does not suppress independently actionable toxicity findings.",
      "show_in_dose_actions": true,
      "dose_calculation": "specialist_review"
    }
  },
  {
    "rule_id": "RAS_EXCLUSION",
    "source": {
      "document": "NCCP 00207 v6",
      "page": 2,
      "url": "https://healthservice.hse.ie/documents/6941/207_Cetuximab_7day_.pdf",
      "checked_date": "2026-11-05",
      "checked": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "indication_id",
          "operator": "==",
          "value": "00207a"
        },
        {
          "field": "ras_status",
          "operator": "in",
          "value": [
            "mutant",
            "unknown"
          ]
        }
      ]
    },
    "action": {
      "type": "contraindicated",
      "components": [
        "cetuximab"
      ],
      "recommendation": "Colorectal cetuximab requires validated extended RAS wild-type status. KRAS exon 2 alone is not sufficient."
    }
  },
  {
    "rule_id": "SKIN_HOLD",
    "source": {
      "document": "NCCP 00207 v6",
      "page": 3,
      "url": "https://healthservice.hse.ie/documents/6941/207_Cetuximab_7day_.pdf",
      "table": 2,
      "checked_date": "2026-11-05",
      "checked": "2026-11-05"
    },
    "condition": {
      "field": "acneiform_rash_grade",
      "operator": ">=",
      "value": 3
    },
    "action": {
      "type": "withhold",
      "components": [
        "cetuximab"
      ],
      "recommendation": "Hold cetuximab for severe skin toxicity; source allows a maximum two-week interruption and requires recovery to grade ≤2 before restart."
    }
  },
  {
    "rule_id": "SKIN_FOURTH",
    "source": {
      "document": "NCCP 00207 v6",
      "page": 3,
      "url": "https://healthservice.hse.ie/documents/6941/207_Cetuximab_7day_.pdf",
      "table": 2,
      "checked_date": "2026-11-05",
      "checked": "2026-11-05"
    },
    "condition": {
      "field": "skin_occurrence",
      "operator": ">=",
      "value": 4
    },
    "action": {
      "type": "discontinue",
      "components": [
        "cetuximab"
      ],
      "recommendation": "Discontinue cetuximab after the fourth severe skin episode."
    }
  },
  {
    "rule_id": "SKIN_FAILED",
    "source": {
      "document": "Erbitux EMA product information (supplementary)",
      "page": "4.4",
      "url": "https://www.ema.europa.eu/en/documents/product-information/erbitux-epar-product-information_en.pdf",
      "checked_date": "2026-11-05",
      "supplementary_basis": "NCCP00207 p3 Table2 maximum two-week interruption",
      "checked": "2026-11-05"
    },
    "condition": {
      "any": [
        {
          "field": "skin_failed_recovery",
          "operator": "==",
          "value": true
        },
        {
          "all": [
            {
              "field": "acneiform_rash_grade",
              "operator": ">=",
              "value": 3
            },
            {
              "field": "skin_delay_weeks",
              "operator": ">=",
              "value": 2
            }
          ]
        }
      ]
    },
    "action": {
      "type": "discontinue",
      "components": [
        "cetuximab"
      ],
      "recommendation": "Discontinue / obtain urgent specialist confirmation when severe skin toxicity has not resolved within the permitted interruption; do not automatically restart."
    }
  },
  {
    "rule_id": "SKIN_RESTART_1",
    "source": {
      "document": "NCCP 00207 v6",
      "page": 3,
      "url": "https://healthservice.hse.ie/documents/6941/207_Cetuximab_7day_.pdf",
      "table": 2,
      "checked_date": "2026-11-05",
      "checked": "2026-11-05"
    },
    "condition": {
      "all": [
        {
          "field": "acneiform_rash_grade",
          "operator": "<=",
          "value": 2
        },
        {
          "field": "skin_occurrence",
          "operator": "==",
          "value": 1
        },
        {
          "field": "skin_delay_weeks",
          "operator": ">",
          "value": 0
        },
        {
          "field": "skin_delay_weeks",
          "operator": "<=",
          "value": 2
        },
        {
          "field": "skin_failed_recovery",
          "operator": "==",
          "value": false
        },
        {
          "field": "previous_cetuximab_dose_mg_m2",
          "operator": ">=",
          "value": 250
        }
      ]
    },
    "action": {
      "type": "consultant_review",
      "components": [
        "cetuximab"
      ],
      "recommendation": "After the documented severe episode recovers within two weeks, source cetuximab restart dose is 250 mg/m². Confirm prior individual reductions; this is not a re-loading dose. Displayed source dose requires a documented previous dose at least this high; do not re-escalate a lower individual dose.",
      "show_in_dose_actions": true,
      "component_changes": {
        "cetuximab": {
          "dose_mg_m2": 250
        }
      }
    }
  },
