  {
    "rule_id": "FIRST_15_MINUTES",
    "source": {
      "document": "Erbitux EMA product information (supplementary)",
      "page": "4.2–4.6",
      "url": "https://www.ema.europa.eu/en/documents/product-information/erbitux-epar-product-information_en.pdf",
      "checked_date": "2026-11-05",
      "checked": "2026-11-05"
    },
    "condition": {
      "field": "reaction_first_15_minutes",
      "operator": "==",
      "value": true
    },
    "action": {
      "type": "withhold",
      "components": [
        "cetuximab"
      ],
      "recommendation": "Interrupt the first infusion for a reaction within 15 minutes irrespective of grade. Assess benefit/risk and IgE-related risk before any resumption."
    }
  },
