          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 4, adverse events"
        },
        "explanation": "Peripheral neuropathy above grade 2: reduce docetaxel to 60 mg/m²."
      },
      {
        "id": "AT423_STOM_G3",
        "when": {
          "field": "stomatitis_grade",
          "operator": ">=",
