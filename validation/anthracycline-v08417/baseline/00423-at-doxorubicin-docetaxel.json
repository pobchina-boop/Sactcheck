  "rule_engine": {
    "evaluation_mode": "highest_priority_triggered",
    "rules": [
      {
        "id": "AT423_ANC_LT1_5",
        "when": {
          "field": "anc_x10e9_l",
          "operator": "<",
          "value": 1.5
        },
        "action": {
          "type": "delay",
          "message": "ANC below 1.5 ×10⁹/L: delay treatment for one week.",
          "components": [
            "whole_regimen"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 1"
        },
        "explanation": "ANC below 1.5 ×10⁹/L: delay treatment for one week."
      },
      {
        "id": "AT423_PLT_LT100",
        "when": {
          "field": "platelets_x10e9_l",
          "operator": "<",
          "value": 100
        },
        "action": {
          "type": "delay",
          "message": "Platelets below 100 ×10⁹/L: delay treatment for one week.",
          "components": [
            "whole_regimen"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 1"
        },
        "explanation": "Platelets below 100 ×10⁹/L: delay treatment for one week."
      },
      {
        "id": "AT423_LVEF_LT50",
        "when": {
          "field": "lvef_percent",
          "operator": "<",
          "value": 50
        },
        "action": {
          "type": "contraindicated",
          "message": "LVEF below 50% is an exclusion for this regimen.",
          "components": [
            "doxorubicin"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 2, Exclusions"
        },
        "explanation": "LVEF below 50% is an exclusion for this regimen.",
        "priority": 98
      },
      {
        "id": "AT423_DOXO_SEVERE_RENAL",
        "when": {
          "field": "renal_impairment_severity",
          "operator": "==",
          "value": "severe"
        },
        "action": {
          "type": "consultant_review",
          "message": "Severe renal impairment: doxorubicin dosing is a clinical decision.",
          "components": [
            "doxorubicin"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 2"
        },
        "explanation": "Severe renal impairment: doxorubicin dosing is a clinical decision."
      },
      {
        "id": "AT423_DOXO_BILI_20_50",
        "when": {
          "all": [
            {
              "field": "bilirubin_umol_l",
              "operator": ">=",
              "value": 20
            },
            {
              "field": "bilirubin_umol_l",
              "operator": "<=",
              "value": 50
            }
          ]
        },
        "action": {
          "type": "dose_reduce",
          "message": "Bilirubin 20 to 50 µmol/L: use 50% of the doxorubicin dose.",
          "components": [
            "doxorubicin"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 2"
        },
        "explanation": "Bilirubin 20 to 50 µmol/L: use 50% of the doxorubicin dose."
      },
      {
        "id": "AT423_DOXO_BILI_51_85",
        "when": {
          "all": [
            {
              "field": "bilirubin_umol_l",
              "operator": ">=",
              "value": 51
            },
            {
              "field": "bilirubin_umol_l",
              "operator": "<=",
              "value": 85
            }
          ]
        },
        "action": {
          "type": "dose_reduce",
          "message": "Bilirubin 51 to 85 µmol/L: use 25% of the doxorubicin dose.",
          "components": [
            "doxorubicin"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 2"
        },
        "explanation": "Bilirubin 51 to 85 µmol/L: use 25% of the doxorubicin dose."
      },
      {
        "id": "AT423_DOXO_BILI_GT85",
        "when": {
          "field": "bilirubin_umol_l",
          "operator": ">",
          "value": 85
        },
        "action": {
          "type": "omit",
          "message": "Bilirubin above 85 µmol/L: omit doxorubicin.",
          "components": [
            "doxorubicin"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 2"
        },
        "explanation": "Bilirubin above 85 µmol/L: omit doxorubicin.",
        "priority": 90
      },
      {
        "id": "AT423_DOXO_AST_2_3",
        "when": {
          "all": [
            {
              "field": "ast_uln_multiple",
              "operator": ">=",
              "value": 2
            },
            {
              "field": "ast_uln_multiple",
              "operator": "<=",
              "value": 3
            }
          ]
        },
        "action": {
          "type": "dose_reduce",
          "message": "AST 2 to 3 × ULN: use 75% of the doxorubicin dose.",
          "components": [
            "doxorubicin"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 2"
        },
        "explanation": "AST 2 to 3 × ULN: use 75% of the doxorubicin dose."
      },
      {
        "id": "AT423_DOXO_AST_GT3",
        "when": {
          "field": "ast_uln_multiple",
          "operator": ">",
          "value": 3
        },
        "action": {
          "type": "dose_reduce",
          "message": "AST above 3 × ULN: use 50% of the doxorubicin dose.",
          "components": [
            "doxorubicin"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 2"
        },
        "explanation": "AST above 3 × ULN: use 50% of the doxorubicin dose."
      },
      {
        "id": "AT423_DOC_HEP_75",
        "when": {
          "all": [
            {
              "field": "alp_uln_multiple",
              "operator": ">",
              "value": 2.5
            },
            {
              "field": "ast_alt_uln_multiple",
              "operator": ">",
              "value": 1.5
            }
          ]
        },
        "action": {
          "type": "dose_reduce",
          "message": "ALP above 2.5 × ULN with AST or ALT above 1.5 × ULN: docetaxel dose 75 mg/m².",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 3"
        },
        "explanation": "ALP above 2.5 × ULN with AST or ALT above 1.5 × ULN: docetaxel dose 75 mg/m²."
      },
      {
        "id": "AT423_DOC_HEP_STOP",
        "when": {
          "all": [
            {
              "any": [
                {
                  "field": "alp_uln_multiple",
                  "operator": ">",
                  "value": 6
                },
                {
                  "field": "ast_alt_uln_multiple",
                  "operator": ">",
                  "value": 3.5
                }
              ]
            },
            {
              "field": "bilirubin_uln_multiple",
              "operator": ">",
              "value": 1
            }
          ]
        },
        "action": {
          "type": "withhold",
          "message": "Marked hepatic dysfunction with bilirubin above ULN: stop docetaxel unless strictly indicated and discuss with a Consultant.",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 3"
        },
        "explanation": "Marked hepatic dysfunction with bilirubin above ULN: stop docetaxel unless strictly indicated and discuss with a Consultant.",
        "priority": 96
      },
      {
        "id": "AT423_SKIN_G3",
        "when": {
          "field": "skin_reaction_grade",
          "operator": ">=",
          "value": 3
        },
        "action": {
          "type": "dose_reduce",
          "message": "Grade 3 skin reaction: reduce docetaxel to 60 mg/m².",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 4, adverse events"
        },
        "explanation": "Grade 3 skin reaction: reduce docetaxel to 60 mg/m²."
      },
      {
        "id": "AT423_NEURO_GT2",
        "when": {
          "field": "neuropathy_grade",
          "operator": ">",
