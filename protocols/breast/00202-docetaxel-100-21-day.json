  "rule_engine": {
    "evaluation_mode": "highest_priority_triggered",
    "rules": [
      {
        "id": "DOC202_ANC_LT1_5",
        "when": {
          "field": "anc_x10e9_l",
          "operator": "<",
          "value": 1.5
        },
        "action": {
          "type": "delay",
          "message": "ANC below 1.5 ×10⁹/L: delay docetaxel until recovery.",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 2, Table 1"
        },
        "explanation": "ANC below 1.5 ×10⁹/L: delay docetaxel until recovery."
      },
      {
        "id": "DOC202_FN",
        "when": {
          "field": "febrile_neutropenia",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "dose_reduce",
          "message": "Febrile neutropenia: reduce docetaxel from 100 to 75 mg/m², and from 75 to 60 mg/m² where applicable.",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 2, Table 1"
        },
        "explanation": "Febrile neutropenia: reduce docetaxel from 100 to 75 mg/m², and from 75 to 60 mg/m² where applicable."
      },
      {
        "id": "DOC202_PROLONGED_SEVERE_NEUTROPENIA",
        "when": {
          "field": "anc_below_0_5_more_than_7_days",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "dose_reduce",
          "message": "ANC below 0.5 ×10⁹/L for more than one week: reduce docetaxel from 100 to 75 mg/m², and from 75 to 60 mg/m² where applicable.",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 2, Table 1"
        },
        "explanation": "ANC below 0.5 ×10⁹/L for more than one week: reduce docetaxel from 100 to 75 mg/m², and from 75 to 60 mg/m² where applicable."
      },
      {
        "id": "DOC202_SEVERE_RENAL",
        "when": {
          "field": "renal_impairment_severity",
          "operator": "==",
          "value": "severe"
        },
        "action": {
          "type": "consultant_review",
          "message": "Severe renal impairment: the NCCP source states that data are unavailable. Review with the Consultant and oncology pharmacy.",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 2"
        },
        "explanation": "Severe renal impairment: the NCCP source states that data are unavailable. Review with the Consultant and oncology pharmacy."
      },
      {
        "id": "DOC202_HEPATIC_75",
        "when": {
          "all": [
            {
              "field": "alp_uln_multiple",
              "operator": ">",
              "value": 2.5
            },
            {
              "field": "ast_alt_uln_multiple",
              "operator": ">",
              "value": 1.5
            }
          ]
        },
        "action": {
          "type": "dose_reduce",
          "message": "ALP above 2.5 × ULN with AST or ALT above 1.5 × ULN: use docetaxel 75 mg/m² in the encoded NCCP pathway.",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 2"
        },
        "explanation": "ALP above 2.5 × ULN with AST or ALT above 1.5 × ULN: use docetaxel 75 mg/m² in the encoded NCCP pathway."
      },
      {
        "id": "DOC202_HEPATIC_STOP",
        "when": {
          "all": [
            {
              "any": [
                {
                  "field": "alp_uln_multiple",
                  "operator": ">",
                  "value": 6
                },
                {
                  "field": "ast_alt_uln_multiple",
                  "operator": ">",
                  "value": 3.5
                }
              ]
            },
            {
              "field": "bilirubin_uln_multiple",
              "operator": ">",
              "value": 1
            }
          ]
        },
        "action": {
          "type": "withhold",
          "message": "Marked hepatic dysfunction with bilirubin above ULN: stop docetaxel unless strictly indicated and discuss with a Consultant.",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 2"
        },
        "explanation": "Marked hepatic dysfunction with bilirubin above ULN: stop docetaxel unless strictly indicated and discuss with a Consultant.",
        "priority": 96
      },
      {
        "id": "DOC202_SKIN_G3",
        "when": {
          "field": "skin_reaction_grade",
          "operator": ">=",
          "value": 3
        },
        "action": {
          "type": "dose_reduce",
          "message": "Grade 3 skin reaction: reduce docetaxel from 100 to 75 mg/m², and from 75 to 60 mg/m² where applicable.",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 3"
        },
        "explanation": "Grade 3 skin reaction: reduce docetaxel from 100 to 75 mg/m², and from 75 to 60 mg/m² where applicable."
      },
      {
        "id": "DOC202_NEURO_GT2",
        "when": {
          "field": "neuropathy_grade",
          "operator": ">",
          "value": 2
        },
        "action": {
          "type": "dose_reduce",
          "message": "Peripheral neuropathy above grade 2: decrease docetaxel to 60 mg/m².",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 3"
        },
        "explanation": "Peripheral neuropathy above grade 2: decrease docetaxel to 60 mg/m²."
      },
      {
        "id": "DOC202_STOMATITIS_G3",
        "when": {
          "field": "stomatitis_grade",
          "operator": ">=",
          "value": 3
        },
        "action": {
          "type": "dose_reduce",
          "message": "Grade 3 or 4 stomatitis: decrease docetaxel to 60 mg/m².",
          "components": [
            "docetaxel"
          ]
        },
        "source": {
          "document": "Current official NCCP regimen PDF",
          "page": "Page 3, Table 3"
        },
        "explanation": "Grade 3 or 4 stomatitis: decrease docetaxel to 60 mg/m²."
      }
    ]
  },
