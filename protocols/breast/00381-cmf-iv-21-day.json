  "rule_engine": {
    "evaluation_mode": "highest_priority_triggered",
    "rules": [
      {
        "id": "anc_below_cutoff",
        "priority": 100,
        "when": {
          "field": "anc_x10e9_l",
          "operator": "<",
          "value": 1.0
        },
        "action": {
          "type": "delay",
          "message": "ANC <1.0 ×10⁹/L: delay CMF according to NCCP haematological Table 1."
        },
        "source": {
          "document": "Official NCCP regimen 00381",
          "page": "Page 2, haematological Table 1"
        },
        "explanation": "ANC <1.0 ×10⁹/L: delay CMF according to NCCP haematological Table 1."
      },
      {
        "id": "platelets_below_cutoff",
        "priority": 100,
        "when": {
          "field": "platelets_x10e9_l",
          "operator": "<",
          "value": 70
        },
        "action": {
          "type": "delay",
          "message": "Platelets below encoded protocol cutoff (70 ×10⁹/L). Review official NCCP regimen and discuss with consultant."
        },
        "source": {
          "document": "Official NCCP regimen 00381",
          "page": "Page 2, haematological Table 1"
        },
        "explanation": "Platelets below encoded protocol cutoff (70 ×10⁹/L). Review official NCCP regimen and discuss with consultant."
      },
      {
        "id": "anc_1_to_1_49_reduce_75",
        "priority": 90,
        "when": {
          "field": "anc_x10e9_l",
          "operator": "between",
          "value": [
            1.0,
            1.49
          ]
        },
        "action": {
          "type": "dose_reduce",
          "message": "ANC 1.0–1.49 ×10⁹/L: NCCP recommends 75% CMF dose."
        },
        "source": {
          "document": "Official NCCP regimen 00381",
          "page": "Page 2, haematological Table 1"
        },
        "explanation": "NCCP haematological Table 1 specifies 75% dose in this ANC band."
      },
      {
        "id": "platelets_70_to_89_reduce_75",
        "priority": 90,
        "when": {
          "field": "platelets_x10e9_l",
          "operator": "between",
          "value": [
            70,
            89
          ]
        },
        "action": {
          "type": "dose_reduce",
          "message": "Platelets 70–89 ×10⁹/L: NCCP recommends 75% CMF dose."
        },
        "source": {
          "document": "Official NCCP regimen 00381",
