  "rule_engine": {
    "evaluation_mode": "highest_priority_triggered",
    "rules": [
      {
        "id": "severe_hepatic_impairment_review",
        "priority": 90,
        "when": {
          "field": "child_pugh_class",
          "operator": "==",
          "value": "C"
        },
        "action": {
          "type": "withhold",
          "message": "Severe hepatic impairment: NCCP states anastrozole is not recommended. Do not continue without Consultant review."
        },
        "source": {
          "document": "Official NCCP regimen 00254",
          "page": "Page 2, renal and hepatic impairment table"
        },
        "explanation": "Severe hepatic impairment: NCCP states anastrozole is not recommended. Do not continue without Consultant review."
      },
      {
        "id": "anastrozole_child_pugh_a_b_no_adjustment",
        "priority": 20,
        "when": {
          "field": "child_pugh_class",
          "operator": "in",
          "value": [
            "A",
            "B"
          ]
        },
        "action": {
          "type": "proceed",
          "message": "Child-Pugh A/B: NCCP states no anastrozole dose adjustment is needed."
        },
        "source": {
          "document": "Official NCCP regimen 00254",
          "page": "Page 2, renal and hepatic impairment table"
        },
        "explanation": "NCCP states no dose adjustment is needed in mild or moderate hepatic impairment."
      }
    ]
  },
