  "rule_engine": {
    "evaluation_mode": "highest_priority_triggered",
    "rules": [
      {
        "id": "pac_anc_lt_0_5_ge7d",
        "priority": 125,
        "when": {
          "all": [
            {
              "field": "anc_x10e9_l",
              "operator": "<",
              "value": 0.5
            },
            {
              "field": "anc_below_0_5_duration_days",
              "operator": ">=",
              "value": 7
            }
          ]
        },
        "action": {
          "type": "delay_then_dose_reduce",
          "message": "ANC <0.5 ×10⁹/L for ≥7 days: delay paclitaxel and reduce by one dose level after recovery."
        },
        "source": {
          "document": "Official NCCP regimen 00815",
          "page": "Page 5, haematological Table 4"
        },
        "explanation": "NCCP Table 4 specifies delay and one-level reduction after recovery."
      },
      {
        "id": "pac_anc_lt_0_5",
        "priority": 115,
        "when": {
          "field": "anc_x10e9_l",
          "operator": "<",
          "value": 0.5
        },
        "action": {
          "type": "delay",
          "message": "ANC <0.5 ×10⁹/L: delay paclitaxel. If this persists for ≥7 days, NCCP requires one dose-level reduction after recovery."
        },
        "source": {
          "document": "Official NCCP regimen 00815",
          "page": "Page 5, haematological Table 4"
        },
        "explanation": "The duration criterion determines whether dose reduction is added to the delay."
      },
      {
        "id": "pac_anc_0_5_to_0_99",
        "priority": 105,
        "when": {
          "field": "anc_x10e9_l",
          "operator": "between",
          "value": [
            0.5,
            0.99
          ]
        },
        "action": {
          "type": "delay",
          "message": "ANC 0.5–0.99 ×10⁹/L: delay paclitaxel and consider dose reduction at the subsequent cycle."
        },
        "source": {
          "document": "Official NCCP regimen 00815",
          "page": "Page 5, haematological Table 4"
        },
        "explanation": "NCCP Table 4 specifies delay and consideration of subsequent dose reduction."
      },
      {
        "id": "pac_platelets_lt70",
        "priority": 120,
        "when": {
          "field": "platelets_x10e9_l",
          "operator": "<",
          "value": 70
        },
        "action": {
          "type": "delay_then_dose_reduce",
          "message": "Platelets <70 ×10⁹/L: delay paclitaxel and reduce by one dose level after recovery."
        },
        "source": {
          "document": "Official NCCP regimen 00815",
          "page": "Page 5, haematological Table 4"
        },
        "explanation": "NCCP Table 4 specifies delay and one-level reduction after recovery."
      },
      {
        "id": "pac_platelets_70_to_89",
        "priority": 105,
        "when": {
          "field": "platelets_x10e9_l",
          "operator": "between",
          "value": [
            70,
            89
          ]
        },
        "action": {
          "type": "delay",
          "message": "Platelets 70–89 ×10⁹/L: delay paclitaxel and consider dose reduction at the subsequent cycle."
        },
        "source": {
          "document": "Official NCCP regimen 00815",
          "page": "Page 5, haematological Table 4"
        },
        "explanation": "NCCP Table 4 specifies delay and consideration of subsequent dose reduction."
      }
    ]
