            "operator": "==",
            "value": false
          }
        ]
      },
      {
        "rule_id": "854_LEN_RENAL_LT30",
        "action": {
          "type": "dose_reduce",
          "components": [
            "Lenalidomide"
          ],
          "recommendation": "Use the protocol severe renal-impairment dose and verify the current product-specific schedule."
        },
        "source": {
          "page": 6,
          "section": "Renal impairment"
        },
        "explanation": "CrCl below 30 mL/min requires a reduced lenalidomide schedule.",
        "all": [
          {
            "field": "crcl_ml_min",
            "operator": "<",
            "value": 30
          },
          {
            "field": "haemodialysis",
            "operator": "==",
            "value": false
          }
        ]
      },
      {
        "rule_id": "854_LEN_DIALYSIS",
        "action": {
          "type": "dose_reduce",
          "components": [
            "Lenalidomide"
          ],
          "recommendation": "Use the protocol dialysis dose and administer after dialysis."
        },
        "source": {
          "page": 6,
          "section": "Renal impairment"
        },
        "explanation": "Haemodialysis requires reduced lenalidomide dosing after dialysis.",
        "field": "haemodialysis",
        "operator": "==",
        "value": true
      },
      {
        "rule_id": "854_LEN_OTHER_G3",
        "action": {
          "type": "withhold_then_reduce",
          "components": [
            "Lenalidomide"
          ],
          "recommendation": "Interrupt lenalidomide; restart at the next lower dose when toxicity has resolved to Grade 2 or less."
        },
        "source": {
          "page": 4,
          "section": "Dose modifications"
        },
        "explanation": "Grade 3–4 non-haematological toxicity related to lenalidomide requires interruption and reduced restart.",
        "field": "other_non_haematological_toxicity_grade",
        "operator": ">=",
        "value": 3
      },
      {
        "rule_id": "854_LEN_VTE",
        "action": {
          "type": "withhold",
          "components": [
