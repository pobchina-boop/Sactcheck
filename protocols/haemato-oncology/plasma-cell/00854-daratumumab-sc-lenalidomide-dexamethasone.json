        "action": {
          "type": "delay",
          "components": [
            "Daratumumab"
          ],
          "recommendation": "Delay daratumumab until blood-count recovery; consider transfusion or growth-factor support as clinically indicated."
        },
        "source": {
          "page": 4,
          "section": "Dose modifications"
        },
        "explanation": "The source permits dose delay, not dose reduction, for haematological toxicity.",
