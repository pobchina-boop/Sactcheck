        },
        "explanation": "The source does not specify a daratumumab hepatic dose adjustment.",
        "field": "bilirubin_ratio_uln",
        "operator": ">",
        "value": 1.0
      },
      {
        "rule_id": "854_LEN_START_COUNTS",
        "action": {
          "type": "delay",
          "components": [
            "Lenalidomide"
          ],
          "recommendation": "Do not start lenalidomide; repeat counts and follow the protocol recovery pathway."
        },
        "source": {
          "page": 4,
          "section": "Dose modifications"
        },
        "explanation": "Lenalidomide must not start if ANC is below 1.0 ×10⁹/L or platelets are below 75 ×10⁹/L.",
        "all": [
          {
            "field": "assessment_phase",
            "operator": "==",
            "value": "cycle_start"
          },
          {
            "any": [
              {
                "field": "anc_x10e9_l",
                "operator": "<",
                "value": 1.0
              },
              {
                "field": "platelets_x10e9_l",
                "operator": "<",
                "value": 75
              }
            ]
          }
        ]
      },
      {
        "rule_id": "854_LEN_SEVERE_COUNTS",
        "action": {
          "type": "withhold_then_reduce",
          "components": [
            "Lenalidomide"
          ],
          "recommendation": "Interrupt lenalidomide and restart using the source occurrence/recovery dose-reduction pathway."
        },
        "source": {
          "page": 5,
          "section": "Haematological toxicity"
        },
        "explanation": "ANC below 0.5 ×10⁹/L or platelets below 30 ×10⁹/L triggers interruption.",
        "any": [
          {
            "field": "anc_x10e9_l",
            "operator": "<",
            "value": 0.5
          },
          {
            "field": "platelets_x10e9_l",
            "operator": "<",
            "value": 30
          }
        ]
      },
      {
