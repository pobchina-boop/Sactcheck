          ],
          "recommendation": "Withhold lenalidomide, treat the thromboembolic event and reassess benefit/risk before restart."
        },
        "source": {
          "page": 6,
          "section": "Other toxicities"
        },
        "explanation": "The source requires treatment interruption and standard anticoagulant management for thromboembolism.",
        "field": "thromboembolic_event",
        "operator": "==",
        "value": true
      },
      {
        "rule_id": "854_LEN_ALLERGY",
        "action": {
          "type": "discontinue",
          "components": [
