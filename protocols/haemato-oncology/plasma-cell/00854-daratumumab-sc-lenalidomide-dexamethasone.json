        },
        "source": {
          "page": 6,
          "section": "Renal impairment"
        },
        "explanation": "CrCl 30–50 mL/min requires the protocol reduced starting dose.",
        "all": [
          {
            "field": "crcl_ml_min",
            "operator": ">=",
            "value": 30
          },
          {
            "field": "crcl_ml_min",
            "operator": "<=",
            "value": 50
          },
          {
