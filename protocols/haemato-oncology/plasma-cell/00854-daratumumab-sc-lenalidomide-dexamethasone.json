        "operator": "==",
        "value": true
      },
      {
        "rule_id": "854_DARA_NO_RENAL_REDUCTION",
        "action": {
          "type": "proceed_with_caution",
          "components": [
            "Daratumumab"
          ],
          "recommendation": "No daratumumab dose adjustment is required for renal impairment; assess the complete regimen and patient context."
        },
        "source": {
          "page": 4,
          "section": "Renal impairment"
        },
        "explanation": "Population pharmacokinetic analysis does not require a daratumumab renal dose adjustment.",
        "field": "crcl_ml_min",
        "operator": "<",
        "value": 50
      },
      {
