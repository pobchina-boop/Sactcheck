    "rules": [
      {
        "rule_id": "435_EXCLUSION_HYPERSENSITIVITY",
        "action": {
          "type": "contraindicated",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Do not administer."
        },
        "source": {
          "page": 2,
          "section": "Exclusions"
        },
        "explanation": "Bortezomib hypersensitivity is an exclusion.",
        "field": "bortezomib_hypersensitivity",
        "operator": "==",
        "value": true
      },
      {
        "rule_id": "435_EXCLUSION_PREGNANCY",
        "action": {
          "type": "contraindicated",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Do not proceed under this protocol."
        },
        "source": {
          "page": 2,
          "section": "Exclusions"
        },
        "explanation": "Pregnancy is an exclusion.",
        "field": "pregnancy",
        "operator": "==",
        "value": true
      },
      {
        "rule_id": "435_PLATELETS_BELOW25",
        "action": {
          "type": "withhold",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Withhold and reassess."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity"
        },
        "explanation": "Platelets below 25 ×10⁹/L require withholding bortezomib.",
        "field": "platelets_x10e9_l",
        "operator": "<",
        "value": 25
      },
      {
        "rule_id": "435_FIRST_LOW_COUNT",
        "action": {
          "type": "delay_then_dose_reduce",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Delay until recovery, then restart at 1.0 mg/m²."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity"
        },
        "explanation": "At the first ANC below 0.5 or platelets below 30 occurrence, delay until recovery and restart at the first reduced dose.",
        "all": [
          {
            "any": [
              {
                "field": "anc_x10e9_l",
                "operator": "<",
                "value": 0.5
              },
              {
                "field": "platelets_x10e9_l",
                "operator": "<",
                "value": 30
              }
            ]
          },
          {
            "field": "low_count_occurrence",
            "operator": "==",
            "value": 0
          }
        ]
      },
      {
        "rule_id": "435_RECURRENT_LOW_COUNT",
        "action": {
          "type": "delay_then_dose_reduce",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Delay until recovery, then restart at 0.7 mg/m²."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity"
        },
        "explanation": "Recurrent ANC below 0.5 or platelets below 30 requires delay and a further reduced restart.",
        "all": [
          {
            "any": [
              {
                "field": "anc_x10e9_l",
                "operator": "<",
                "value": 0.5
              },
              {
                "field": "platelets_x10e9_l",
                "operator": "<",
                "value": 30
              }
            ]
          },
          {
            "field": "low_count_occurrence",
            "operator": ">=",
            "value": 1
          }
        ]
      },
      {
        "rule_id": "435_HAEMODIALYSIS_TIMING",
        "action": {
          "type": "consultant_review",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Confirm post-dialysis timing."
        },
        "source": {
          "page": 3,
          "section": "Renal impairment"
        },
        "explanation": "No renal dose adjustment is specified, but administration should occur after haemodialysis.",
        "field": "haemodialysis",
        "operator": "==",
        "value": true
      },
      {
        "rule_id": "435_HEPATIC_STARTING_DOSE",
        "action": {
          "type": "dose_reduce",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Start at 0.7 mg/m² and adjust according to tolerance."
        },
        "source": {
          "page": 3,
          "section": "Hepatic impairment"
        },
        "explanation": "Bilirubin above 1.5 × ULN requires the reduced hepatic starting-dose pathway.",
        "field": "bilirubin_ratio_uln",
        "operator": ">",
        "value": 1.5
      },
      {
        "rule_id": "435_NEUROPATHY_G1_PAIN",
        "action": {
          "type": "dose_reduce",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Reduce to 1.0 mg/m² or weekly administration."
        },
        "source": {
          "page": 4,
          "section": "Peripheral neuropathy"
        },
        "explanation": "Grade 1 neuropathy with pain requires dose/schedule modification.",
        "all": [
          {
            "field": "neuropathy_grade",
            "operator": "==",
            "value": 1
          },
          {
            "field": "neuropathic_pain",
            "operator": "==",
            "value": true
          }
        ]
      },
      {
        "rule_id": "435_NEUROPATHY_G2",
        "action": {
          "type": "dose_reduce",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Reduce to 1.0 mg/m² or weekly administration."
        },
        "source": {
          "page": 4,
          "section": "Peripheral neuropathy"
        },
        "explanation": "Grade 2 neuropathy without pain requires dose/schedule modification.",
        "all": [
          {
            "field": "neuropathy_grade",
            "operator": "==",
            "value": 2
          },
          {
            "field": "neuropathic_pain",
            "operator": "==",
            "value": false
          }
        ]
      },
      {
        "rule_id": "435_NEUROPATHY_G2_PAIN_G3",
        "action": {
          "type": "withhold_then_reduce",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Withhold, then restart at 0.7 mg/m² weekly after recovery."
        },
        "source": {
          "page": 4,
          "section": "Peripheral neuropathy"
        },
        "explanation": "Grade 2 neuropathy with pain or Grade 3 requires withholding and reduced weekly restart after recovery.",
        "any": [
          {
            "all": [
              {
                "field": "neuropathy_grade",
                "operator": "==",
                "value": 2
              },
              {
                "field": "neuropathic_pain",
                "operator": "==",
                "value": true
              }
            ]
          },
          {
            "field": "neuropathy_grade",
            "operator": "==",
            "value": 3
          }
        ]
      },
      {
        "rule_id": "435_NEUROPATHY_G4_AUTONOMIC",
        "action": {
          "type": "discontinue",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Discontinue bortezomib."
        },
        "source": {
          "page": 4,
          "section": "Peripheral neuropathy"
        },
        "explanation": "Grade 4 or severe autonomic neuropathy requires discontinuation.",
        "any": [
          {
            "field": "neuropathy_grade",
            "operator": "==",
            "value": 4
          },
          {
            "field": "severe_autonomic_neuropathy",
            "operator": "==",
            "value": true
          }
        ]
      },
      {
        "rule_id": "435_GRADE3_NONHAEM",
        "action": {
          "type": "withhold_then_reduce",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Withhold until recovery and restart at a reduced dose."
        },
        "source": {
          "page": 4,
          "section": "Non-haematological toxicity"
        },
        "explanation": "Grade 3 or greater non-haematological toxicity requires withholding and reduced-dose restart.",
        "field": "other_non_haematological_toxicity_grade",
        "operator": ">=",
        "value": 3
      },
      {
        "rule_id": "435_PULMONARY_SYMPTOMS",
        "action": {
          "type": "withhold",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Withhold and investigate."
        },
        "source": {
          "page": 4,
          "section": "Pulmonary toxicity"
        },
        "explanation": "New or worsening pulmonary symptoms require withholding and diagnostic evaluation.",
        "field": "new_or_worsening_pulmonary_symptoms",
        "operator": "==",
        "value": true
      },
      {
        "rule_id": "435_PRES",
        "action": {
          "type": "discontinue",
          "components": [
            "Bortezomib"
          ],
          "recommendation": "Discontinue and manage urgently."
        },
        "source": {
          "page": 4,
          "section": "PRES"
        },
        "explanation": "PRES requires discontinuation.",
        "field": "pres_suspected",
        "operator": "==",
        "value": true
      }
    ]
