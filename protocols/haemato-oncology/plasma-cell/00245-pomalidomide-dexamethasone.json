    "rules": [
      {
        "rule_id": "245_EXCLUSIONS",
        "action": {
          "type": "contraindicated",
          "components": [
            "Whole regimen"
          ],
          "recommendation": "Do not initiate; obtain Consultant Haematologist review."
        },
        "source": {
          "page": 2,
          "section": "Eligibility and exclusions",
          "document": "Current mapped NCCP source"
        },
        "explanation": "A protocol-listed exclusion has been recorded.",
        "any": [
          {
            "field": "protocol_hypersensitivity",
            "operator": "==",
            "value": true
          },
          {
            "field": "pregnancy",
            "operator": "==",
            "value": true
          },
          {
            "field": "breastfeeding",
            "operator": "==",
            "value": true
          },
          {
            "field": "pregnancy_prevention_programme_compliant",
            "operator": "==",
            "value": false
          }
        ]
      },
      {
        "rule_id": "245_POM_NEW_CYCLE",
        "action": {
          "type": "delay",
          "components": [
            "Pomalidomide"
          ],
          "recommendation": "Do not start the new pomalidomide cycle; repeat counts."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity",
          "document": "Current mapped NCCP source"
        },
        "explanation": "A new cycle requires ANC above 1.0 ×10⁹/L and platelets at least 50 ×10⁹/L.",
        "all": [
          {
            "field": "assessment_phase",
            "operator": "==",
            "value": "cycle_start"
          },
          {
            "any": [
              {
                "field": "anc_x10e9_l",
                "operator": "<=",
                "value": 1.0
              },
              {
                "field": "platelets_x10e9_l",
                "operator": "<",
                "value": 50
              }
            ]
          }
        ]
      },
      {
        "rule_id": "245_POM_INTERRUPT",
        "action": {
          "type": "withhold_then_reduce",
          "components": [
            "Pomalidomide"
          ],
          "recommendation": "Interrupt pomalidomide, follow FBC weekly and restart one dose level lower after recovery."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity",
          "document": "Current mapped NCCP source"
        },
        "explanation": "ANC below 0.5 ×10⁹/L, protocol-defined febrile neutropenia, or platelets below 25 ×10⁹/L triggers interruption.",
        "any": [
          {
            "field": "anc_x10e9_l",
            "operator": "<",
            "value": 0.5
          },
          {
            "field": "platelets_x10e9_l",
            "operator": "<",
            "value": 25
          },
          {
            "field": "febrile_neutropenia",
            "operator": "==",
            "value": true
          }
        ]
      },
      {
        "rule_id": "245_POM_RECOVERY",
        "action": {
          "type": "dose_reduce_one_level",
          "components": [
            "Pomalidomide"
          ],
          "recommendation": "Resume pomalidomide one dose level below the previous dose."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity",
          "document": "Current mapped NCCP source"
        },
        "explanation": "Following a cytopenia interruption, recovery to ANC at least 1.0 ×10⁹/L and platelets at least 50 ×10⁹/L permits reduced restart.",
        "all": [
          {
            "field": "assessment_phase",
            "operator": "==",
            "value": "recovery_review"
          },
          {
            "field": "previous_pomalidomide_interruption",
            "operator": "==",
            "value": true
          },
          {
            "field": "anc_x10e9_l",
            "operator": ">=",
            "value": 1.0
          },
          {
            "field": "platelets_x10e9_l",
            "operator": ">=",
            "value": 50
          }
        ]
      },
      {
        "rule_id": "245_POM_DIALYSIS",
        "action": {
          "type": "proceed_with_caution",
          "components": [
            "Pomalidomide"
          ],
          "recommendation": "Administer pomalidomide after haemodialysis and verify the regimen-specific dose."
        },
        "source": {
          "page": 3,
          "section": "Renal impairment",
          "document": "Current mapped NCCP source"
        },
        "explanation": "The source specifies post-dialysis administration.",
        "field": "haemodialysis",
        "operator": "==",
        "value": true
      },
      {
        "rule_id": "245_POM_VTE",
        "action": {
          "type": "withhold",
          "components": [
            "Pomalidomide"
          ],
          "recommendation": "Withhold pomalidomide and manage the thromboembolic event before reassessing treatment."
        },
        "source": {
          "page": 5,
          "section": "Other toxicities",
          "document": "Current mapped NCCP source"
        },
        "explanation": "A current thromboembolic event requires interruption and clinical management.",
        "field": "thromboembolic_event",
        "operator": "==",
        "value": true
      },
      {
        "rule_id": "245_POM_ALLERGY",
        "action": {
          "type": "discontinue",
          "components": [
            "Pomalidomide"
          ],
          "recommendation": "Discontinue pomalidomide and obtain urgent clinical review."
        },
        "source": {
          "page": 5,
          "section": "Other toxicities",
          "document": "Current mapped NCCP source"
        },
        "explanation": "Severe allergic skin reaction or angioedema requires discontinuation.",
        "field": "severe_skin_reaction_or_angioedema",
        "operator": "==",
        "value": true
      },
      {
        "rule_id": "245_POM_COUNTS_OK",
        "action": {
          "type": "proceed",
          "components": [
            "Pomalidomide"
          ],
          "recommendation": "Entered cycle-start counts meet the protocol new-cycle thresholds, subject to all other criteria."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity",
          "document": "Current mapped NCCP source"
        },
        "explanation": "ANC above 1.0 ×10⁹/L and platelets at least 50 ×10⁹/L meet the encoded new-cycle criteria.",
        "all": [
          {
            "field": "assessment_phase",
            "operator": "==",
            "value": "cycle_start"
          },
          {
            "field": "anc_x10e9_l",
            "operator": ">",
            "value": 1.0
          },
          {
            "field": "platelets_x10e9_l",
            "operator": ">=",
            "value": 50
          }
        ]
      },
      {
        "rule_id": "245_POM_HEPATIC",
        "action": {
          "type": "consultant_review",
          "components": [
            "Pomalidomide"
          ],
          "recommendation": "Monitor carefully and use interruption or dose reduction as clinically required."
        },
        "source": {
          "page": 3,
          "section": "Hepatic impairment",
          "document": "Current mapped NCCP source"
        },
        "explanation": "The source does not require a starting-dose adjustment by Child–Pugh class but recommends careful monitoring.",
        "any": [
          {
            "field": "child_pugh_class",
            "operator": "==",
            "value": "A"
          },
          {
            "field": "child_pugh_class",
            "operator": "==",
