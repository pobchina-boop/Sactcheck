    "rules": [
      {
        "rule_id": "273_EXCLUSIONS",
        "action": {
          "type": "contraindicated",
          "components": [
            "Whole regimen"
          ],
          "recommendation": "Do not initiate; obtain Consultant Haematologist review."
        },
        "source": {
          "page": 2,
          "section": "Eligibility and exclusions"
        },
        "explanation": "A protocol-listed exclusion has been recorded.",
        "any": [
          {
            "field": "protocol_hypersensitivity",
            "operator": "==",
            "value": true
          },
          {
            "field": "pregnancy",
            "operator": "==",
            "value": true
          },
          {
            "field": "breastfeeding",
            "operator": "==",
            "value": true
          }
        ]
      },
      {
        "rule_id": "273_CYCLE_START_COUNTS",
        "action": {
          "type": "delay_then_dose_reduce",
          "components": [
            "Bortezomib",
            "Cyclophosphamide"
          ],
          "recommendation": "Delay until recovery, check FBC weekly and reduce bortezomib to 1.0 mg/m² when restarting."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity"
        },
        "explanation": "Before a new cycle, ANC below 0.5 ×10⁹/L or platelets below 30 ×10⁹/L triggers delay and reduced restart.",
        "all": [
          {
            "field": "assessment_phase",
            "operator": "==",
            "value": "cycle_start"
          },
          {
            "any": [
              {
                "field": "anc_x10e9_l",
                "operator": "<",
                "value": 0.5
              },
              {
                "field": "platelets_x10e9_l",
                "operator": "<",
                "value": 30
              }
            ]
          }
        ]
      },
      {
        "rule_id": "273_TREATMENT_DAY_COUNTS",
        "action": {
          "type": "withhold_then_reduce",
          "components": [
            "Bortezomib",
            "Cyclophosphamide"
          ],
          "recommendation": "Omit cyclophosphamide on day 15, withhold bortezomib until recovery and restart bortezomib at the next lower dose level."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity"
        },
        "explanation": "During a cycle, ANC below 0.5 ×10⁹/L or platelets below 30 ×10⁹/L triggers component-specific interruption.",
        "all": [
          {
            "field": "assessment_phase",
            "operator": "==",
            "value": "treatment_day"
          },
          {
            "any": [
              {
                "field": "anc_x10e9_l",
                "operator": "<",
                "value": 0.5
              },
              {
                "field": "platelets_x10e9_l",
                "operator": "<",
                "value": 30
              }
            ]
          }
        ]
      },
      {
        "rule_id": "273_COUNTS_OK",
        "action": {
          "type": "proceed",
          "components": [
            "Bortezomib",
            "Cyclophosphamide"
          ],
          "recommendation": "Entered counts meet the encoded cycle-start thresholds, subject to all other criteria."
        },
        "source": {
          "page": 3,
          "section": "Haematological toxicity"
        },
        "explanation": "ANC at least 0.5 ×10⁹/L and platelets at least 30 ×10⁹/L meet the source cycle-start thresholds.",
        "all": [
          {
            "field": "assessment_phase",
            "operator": "==",
            "value": "cycle_start"
          },
          {
            "field": "anc_x10e9_l",
            "operator": ">=",
            "value": 0.5
          },
          {
            "field": "platelets_x10e9_l",
            "operator": ">=",
            "value": 30
          }
        ]
      },
