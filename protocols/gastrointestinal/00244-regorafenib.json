            "operator": "==",
            "value": 2
          },
          {
            "field": "hfsr_occurrence",
            "operator": "<=",
            "value": 1
          },
          {
            "field": "hfsr_no_improvement_7_days",
            "operator": "==",
            "value": false
          }
        ],
        "action": {
          "type": "dose_reduce",
          "components": [
            "regorafenib"
          ],
          "recommendation": "Decrease dose by 40 mg and institute supportive measures."
        },
        "source": {
          "page": 3,
          "document": "Current mapped NCCP source"
        },
        "explanation": "First grade 2 HFSR requires a 40 mg reduction."
      },
      {
        "rule_id": "HFSR_G2_PERSIST",
        "all": [
          {
            "field": "hfsr_grade",
            "operator": "==",
            "value": 2
          },
          {
            "any": [
              {
                "field": "hfsr_no_improvement_7_days",
                "operator": "==",
                "value": true
              },
              {
                "field": "hfsr_occurrence",
                "operator": ">=",
                "value": 2
              }
            ]
          }
        ],
        "action": {
          "type": "withhold_then_reduce",
          "components": [
            "regorafenib"
          ],
          "recommendation": "Interrupt until grade 0–1, then restart 40 mg lower."
        },
        "source": {
          "page": 3,
          "document": "Current mapped NCCP source"
        },
        "explanation": "Persistent/recurrent grade 2 HFSR."
      },
      {
        "rule_id": "HFSR_G2_FOURTH",
        "all": [
          {
            "field": "hfsr_grade",
            "operator": "==",
            "value": 2
          },
          {
