    "rules": [
      {
        "id": "ECOG_3",
        "priority": 8,
        "when": {
          "field": "ecog",
          "operator": ">=",
          "value": "3"
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "whole_regimen"
          ],
          "message": "ECOG 3–4 requires Consultant review of indication, benefit and treatment tolerance."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modifications"
        },
        "explanation": "ECOG 3–4 requires Consultant review of indication, benefit and treatment tolerance."
      },
      {
        "id": "NONHAEM_G3",
        "priority": 9,
        "when": {
          "field": "non_haematological_toxicity_grade",
          "operator": ">=",
          "value": 3
        },
        "action": {
          "type": "withhold",
          "components": [
            "whole_regimen"
          ],
          "message": "Grade 3 or worse non-haematological toxicity requires treatment interruption and protocol-specific review."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modifications"
        },
        "explanation": "Grade 3 or worse non-haematological toxicity requires treatment interruption and protocol-specific review."
      },
      {
        "id": "HSR_G3",
        "priority": 10,
        "when": {
          "field": "hypersensitivity_grade",
          "operator": ">=",
          "value": 3
        },
        "action": {
          "type": "withhold",
          "components": [
            "whole_regimen"
          ],
          "message": "Stop the infusion and initiate emergency management. Identify the causative infusion before deciding which drug to discontinue. Follow the agent-specific protocol."
        },
        "source": {
          "document": "NCCP 00929 v1",
          "page": 8
        },
        "explanation": "Stop the infusion and initiate emergency management. Identify the causative infusion before deciding which drug to discontinue. Follow the agent-specific protocol."
      },
      {
        "id": "ANC_LT1",
        "priority": 9,
        "when": {
          "all": [
            {
              "field": "treatment_phase",
              "operator": "==",
              "value": "combination"
            },
            {
              "all": [
                {
                  "field": "anc",
                  "operator": ">=",
                  "value": 0.5
                },
                {
                  "field": "anc",
                  "operator": "<",
                  "value": 1
                }
              ]
            }
          ]
        },
        "action": {
          "type": "delay",
          "components": [
            "paclitaxel",
            "carboplatin"
          ],
          "message": "Delay paclitaxel and carboplatin until neutrophil recovery."
        },
        "source": {
          "document": "NCCP 00929 v1",
          "page": 5
        },
        "explanation": "Delay paclitaxel and carboplatin until neutrophil recovery."
      },
      {
        "id": "PLT_LT100",
        "priority": 9,
        "when": {
          "all": [
            {
              "field": "treatment_phase",
              "operator": "==",
              "value": "combination"
            },
            {
              "all": [
                {
                  "field": "platelets",
                  "operator": ">=",
                  "value": 50
                },
                {
                  "field": "platelets",
                  "operator": "<",
                  "value": 100
                }
              ]
            }
          ]
        },
        "action": {
          "type": "delay",
          "components": [
            "paclitaxel",
            "carboplatin"
