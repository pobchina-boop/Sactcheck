    "rules": [
      {
        "id": "SELECT_VISIT",
        "priority": 9,
        "when": {
          "field": "treatment_visit",
          "operator": "missing"
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "whole_regimen"
          ],
          "message": "Select the visit before interpreting component-specific dosing or toxicity."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Treatment"
        },
        "explanation": "Select the visit before interpreting component-specific dosing or toxicity."
      },
      {
        "id": "GTN_HCG_PLATEAU",
        "priority": 9,
        "when": {
          "field": "serum_hcg_trend",
          "operator": "in",
          "value": [
            "plateau",
            "rising"
          ]
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "whole_regimen"
          ],
          "message": "Plateauing or rising hCG requires GTN specialist review of resistance/relapse and regimen escalation."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Dose modifications"
        },
        "explanation": "Plateauing or rising hCG requires GTN specialist review of resistance/relapse and regimen escalation."
      },
      {
        "id": "CURATIVE_COUNTS",
        "priority": 9,
        "when": {
          "any": [
            {
              "field": "anc",
              "operator": "<",
              "value": 1
            },
            {
              "field": "platelets",
              "operator": "<",
              "value": 75
            },
            {
              "field": "febrile_neutropenia",
              "operator": "==",
              "value": true
            }
          ]
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "methotrexate"
          ],
          "message": "These low counts flag specialist review rather than a protocol dose band. Assess fever urgently. Avoid dose changes without the GTN consultant."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Dose modifications"
        },
        "explanation": "These low counts flag specialist review rather than a protocol dose band. Assess fever urgently. Avoid dose changes without the GTN consultant."
      },
      {
        "id": "MTX_LT20",
        "priority": 9,
        "when": {
          "field": "crcl_ml_min",
          "operator": "<",
          "value": 20
        },
        "action": {
          "type": "withhold",
          "components": [
            "methotrexate"
          ],
          "message": "Methotrexate is not recommended below 20 mL/min. Discuss with GTN and renal specialists."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Table 1"
        },
        "explanation": "Methotrexate is not recommended below 20 mL/min. Discuss with GTN and renal specialists."
      },
      {
        "id": "MTX_20_49",
        "priority": 9,
        "when": {
          "all": [
            {
              "field": "crcl_ml_min",
              "operator": ">=",
              "value": 20
            },
            {
              "field": "crcl_ml_min",
              "operator": "<",
              "value": 50
            }
          ]
        },
        "action": {
          "type": "dose_reduce",
          "components": [
            "methotrexate"
          ],
          "message": "Table 1 specifies 50% of the original dose. Confirm with the treating consultant."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Table 1"
        },
        "explanation": "Table 1 specifies 50% of the original dose. Confirm with the treating consultant."
      },
      {
        "id": "MTX_AT50",
        "priority": 9,
        "when": {
          "field": "crcl_ml_min",
          "operator": "==",
          "value": 50
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "methotrexate"
          ],
          "message": "The printed renal bands overlap at 50 mL/min. Resolve with the prescribing consultant and oncology pharmacy."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Table 1"
        },
        "explanation": "The printed renal bands overlap at 50 mL/min. Resolve with the prescribing consultant and oncology pharmacy."
      },
      {
        "id": "MTX_BILI",
        "priority": 9,
        "when": {
          "field": "bilirubin_umol_l",
          "operator": ">",
          "value": 86
        },
        "action": {
          "type": "withhold",
          "components": [
            "methotrexate"
          ],
          "message": "Avoid methotrexate when bilirubin exceeds 86 µmol/L."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Table 1"
        },
        "explanation": "Avoid methotrexate when bilirubin exceeds 86 µmol/L."
      },
      {
        "id": "MTX_LYMPHOMA",
        "priority": 9,
        "when": {
          "field": "malignant_lymphoma",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "permanently_discontinue",
          "components": [
            "methotrexate"
          ],
          "message": "Discontinue methotrexate."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Table 2"
        },
        "explanation": "Discontinue methotrexate."
      },
      {
        "id": "MTX_RESCUE",
        "priority": 9,
        "when": {
          "field": "folinic_acid_rescue_confirmed",
          "operator": "==",
          "value": false
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "folinic acid"
          ],
          "message": "Contact the treating unit urgently to arrange rescue if late or missing. Confirm injection time. Do not omit rescue or automatically double a dose."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Treatment"
        },
        "explanation": "Contact the treating unit urgently to arrange rescue if late or missing. Confirm injection time. Do not omit rescue or automatically double a dose."
      },
      {
        "id": "MTX_MOUTH",
        "priority": 9,
        "when": {
          "field": "mucositis_grade",
          "operator": ">=",
          "value": 2
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "methotrexate"
          ],
          "message": "Assess hydration and oral intake. Discuss any dose change with the GTN consultant."
        },
        "source": {
          "document": "NCCP 00246 v5",
          "page": "Dose modifications"
        },
        "explanation": "Assess hydration and oral intake. Discuss any dose change with the GTN consultant."
      }
    ]
