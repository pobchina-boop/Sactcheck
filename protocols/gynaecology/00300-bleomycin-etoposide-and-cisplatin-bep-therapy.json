    "rules": [
      {
        "id": "SELECT_VISIT",
        "priority": 9,
        "when": {
          "field": "treatment_visit",
          "operator": "missing"
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "whole_regimen"
          ],
          "message": "Select the visit before interpreting component-specific dosing or toxicity."
        },
        "source": {
          "document": "NCCP 00300 v7b",
          "page": "Treatment"
        },
        "explanation": "Select the visit before interpreting component-specific dosing or toxicity."
      },
      {
        "id": "COUNTS_CURATIVE",
        "priority": 9,
        "when": {
          "any": [
            {
              "field": "anc",
              "operator": "<",
              "value": 1.5
            },
            {
              "field": "platelets",
              "operator": "<",
              "value": 100
            },
            {
              "field": "febrile_neutropenia",
              "operator": "==",
              "value": true
            }
          ]
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "whole_regimen"
          ],
          "message": "Assess fever urgently. Counts require prescriber review. Avoid routine delays or dose reductions. Any delay requires consultant approval."
        },
        "source": {
          "document": "NCCP 00300 v7b",
          "page": "Haematological"
        },
        "explanation": "Assess fever urgently. Counts require prescriber review. Avoid routine delays or dose reductions. Any delay requires consultant approval."
      },
      {
        "id": "CIS_CURATIVE",
        "priority": 9,
        "when": {
          "all": [
            {
              "field": "crcl_ml_min",
              "operator": "missing"
            },
            {
              "all": [
                {
                  "field": "treatment_visit",
                  "operator": "in",
                  "value": [
                    "day1",
                    "days2to5"
                  ]
                },
                {
                  "field": "cisplatin_renal_band",
                  "operator": "in",
                  "value": [
                    "40_49",
                    "50_59"
                  ]
                }
              ]
            }
          ]
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "cisplatin"
          ],
          "message": "For curative BEP the consultant may retain full cisplatin with extra hydration, longer infusion and daily creatinine. Discuss Table 1 alternatives."
        },
        "source": {
          "document": "NCCP 00300 v7b",
          "page": "Table 1"
        },
        "explanation": "For curative BEP the consultant may retain full cisplatin with extra hydration, longer infusion and daily creatinine. Discuss Table 1 alternatives."
      },
      {
        "id": "CIS_LOW",
        "priority": 9,
        "when": {
          "all": [
            {
              "field": "crcl_ml_min",
              "operator": "missing"
            },
            {
              "all": [
                {
                  "field": "treatment_visit",
                  "operator": "in",
                  "value": [
                    "day1",
                    "days2to5"
                  ]
                },
                {
                  "field": "cisplatin_renal_band",
                  "operator": "==",
                  "value": "lt40"
                }
              ]
            }
          ]
        },
        "action": {
          "type": "withhold",
          "components": [
            "cisplatin"
          ],
          "message": "Cisplatin is not recommended below 40 mL/min. Discuss the curative treatment plan urgently."
        },
        "source": {
          "document": "NCCP 00300 v7b",
          "page": "Table 1"
        },
        "explanation": "Cisplatin is not recommended below 40 mL/min. Discuss the curative treatment plan urgently."
      },
      {
        "id": "CIS_MG",
        "priority": 9,
        "when": {
          "all": [
            {
              "field": "treatment_visit",
              "operator": "in",
              "value": [
                "day1",
                "days2to5"
              ]
            },
            {
              "field": "magnesium_low_or_unreplaced",
              "operator": "==",
              "value": true
            }
          ]
        },
        "action": {
          "type": "withhold",
