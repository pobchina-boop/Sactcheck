    "rules": [
      {
        "id": "ECOG_3",
        "priority": 9,
        "when": {
          "field": "ecog",
          "operator": ">=",
          "value": "3"
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "whole_regimen"
          ],
          "message": "ECOG 3–4 requires Consultant review of indication, benefit and treatment tolerance."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Dose modifications"
        },
        "explanation": "ECOG 3–4 requires Consultant review of indication, benefit and treatment tolerance."
      },
      {
        "id": "BASELINE_ANC",
        "priority": 9,
        "when": {
          "all": [
            {
              "field": "assessment_phase",
              "operator": "==",
              "value": "pre_treatment"
            },
            {
              "field": "anc",
              "operator": "<=",
              "value": 1.5
            }
          ]
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "topotecan"
          ],
          "message": "First treatment requires ANC above 1.5. Review eligibility before starting."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Eligibility"
        },
        "explanation": "First treatment requires ANC above 1.5. Review eligibility before starting."
      },
      {
        "id": "WEEKLY_COUNTS",
        "priority": 9,
        "when": {
          "any": [
            {
              "field": "anc",
              "operator": "<",
              "value": 1
            },
            {
              "field": "platelets",
              "operator": "<",
              "value": 100
            },
            {
              "field": "haemoglobin",
              "operator": "<",
              "value": 9
            }
          ]
        },
        "action": {
          "type": "withhold",
          "components": [
            "topotecan"
          ],
          "message": "Delay until recovery. Check haemoglobin after transfusion if required."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Table 1"
        },
        "explanation": "Delay until recovery. Check haemoglobin after transfusion if required."
      },
      {
        "id": "SEVERE_COUNTS",
        "priority": 9,
        "when": {
          "any": [
            {
              "field": "prolonged_neutropenia",
              "operator": "==",
              "value": true
            },
            {
              "field": "platelets",
              "operator": "<",
              "value": 25
            },
            {
              "field": "febrile_neutropenia",
              "operator": "==",
              "value": true
            }
          ]
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "topotecan"
          ],
          "message": "Assess urgently if unwell. Consider a subsequent reduction or count support after recovery."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Table 1"
        },
        "explanation": "Assess urgently if unwell. Consider a subsequent reduction or count support after recovery."
      },
      {
        "id": "RENAL_20_39",
        "priority": 9,
        "when": {
          "field": "topotecan_renal_band",
          "operator": "==",
          "value": "20_39"
        },
        "action": {
          "type": "dose_reduce",
          "components": [
            "topotecan"
          ],
          "message": "Use 50% of the original dose at CrCl 20–39."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Table 2"
        },
        "explanation": "Use 50% of the original dose at CrCl 20–39."
      },
      {
        "id": "RENAL_lt20",
        "priority": 9,
        "when": {
          "field": "topotecan_renal_band",
          "operator": "==",
          "value": "lt20"
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "topotecan"
          ],
          "message": "Below 20, use is not recommended. Only if unavoidable, consult the source about 25% of the original dose."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Table 2"
        },
        "explanation": "Below 20, use is not recommended. Only if unavoidable, consult the source about 25% of the original dose."
      },
      {
        "id": "RENAL_dialysis",
        "priority": 9,
        "when": {
          "field": "topotecan_renal_band",
          "operator": "==",
          "value": "dialysis"
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "topotecan"
          ],
          "message": "Discuss dialysis-specific management with the consultant and pharmacy."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Table 2"
        },
        "explanation": "Discuss dialysis-specific management with the consultant and pharmacy."
      },
      {
        "id": "BILI",
        "priority": 9,
        "when": {
          "field": "bilirubin_umol_l",
          "operator": ">",
          "value": 171
        },
        "action": {
          "type": "withhold",
          "components": [
            "topotecan"
          ],
          "message": "Topotecan is not recommended when bilirubin exceeds 171 µmol/L."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Table 2"
        },
        "explanation": "Topotecan is not recommended when bilirubin exceeds 171 µmol/L."
      },
      {
        "id": "ILD",
        "priority": 9,
        "when": {
          "field": "confirmed_ild",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "permanently_discontinue",
          "components": [
            "topotecan"
          ],
          "message": "Discontinue topotecan for confirmed interstitial lung disease."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Table 3"
        },
        "explanation": "Discontinue topotecan for confirmed interstitial lung disease."
      },
      {
        "id": "NON_HAEM",
        "priority": 9,
        "when": {
          "all": [
            {
              "field": "non_haematological_toxicity_grade",
              "operator": ">=",
              "value": 3
            },
            {
              "field": "nonhaem_other_than_nausea",
              "operator": "==",
              "value": true
            }
          ]
        },
        "action": {
          "type": "dose_reduce",
          "components": [
            "topotecan"
          ],
          "message": "Decrease dose by 25% after consultant review. Nausea is excluded from this rule."
        },
        "source": {
          "document": "NCCP 00312 v5",
          "page": "Table 3"
        },
        "explanation": "Decrease dose by 25% after consultant review. Nausea is excluded from this rule."
      }
    ]
  },
