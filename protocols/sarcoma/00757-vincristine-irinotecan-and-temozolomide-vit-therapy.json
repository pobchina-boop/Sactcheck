      {
        "id": "DIARRHOEA_G3",
        "priority": 9,
        "when": {
          "field": "diarrhoea_grade",
          "operator": ">=",
          "value": 3
        },
        "action": {
          "type": "dose_reduce",
          "components": [
            "irinotecan",
            "temozolomide"
          ],
          "message": "Grade ≥3 diarrhoea lasting ≥3 days: reduce irinotecan/temozolomide according to the source occurrence pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Grade ≥3 diarrhoea lasting ≥3 days: reduce irinotecan/temozolomide according to the source occurrence pathway."
      },
      {
        "id": "DIARRHOEA_GT14",
        "priority": 10,
        "when": {
          "field": "diarrhoea_duration_days",
          "operator": ">",
          "value": 14
        },
        "action": {
          "type": "permanently_discontinue",
          "components": [
            "whole_regimen"
          ],
          "message": "Clinically significant diarrhoea persisting >2 weeks: discontinue the affected treatment pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Clinically significant diarrhoea persisting >2 weeks: discontinue the affected treatment pathway."
      },
      {
        "id": "DIARRHOEA_REC",
        "priority": 9,
        "when": {
          "field": "diarrhoea_recurrence",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "dose_reduce_one_level",
          "components": [
            "whole_regimen"
          ],
          "message": "Recurrent Grade ≥3 diarrhoea: apply a further dose reduction; repeated recurrence may require discontinuation."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Recurrent Grade ≥3 diarrhoea: apply a further dose reduction; repeated recurrence may require discontinuation."
      },
      {
        "id": "NONHAEM_G3",
        "priority": 9,
        "when": {
          "field": "other_nonhaem_toxicity_grade",
          "operator": ">=",
          "value": 3
        },
        "action": {
          "type": "dose_reduce",
          "components": [
            "irinotecan",
            "temozolomide"
          ],
          "message": "Grade 3 non-haematological toxicity: reduce irinotecan and temozolomide after recovery."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Grade 3 non-haematological toxicity: reduce irinotecan and temozolomide after recovery."
      },
      {
        "id": "NONHAEM_G4",
        "priority": 10,
        "when": {
          "field": "other_nonhaem_toxicity_grade",
          "operator": ">=",
          "value": 4
        },
        "action": {
          "type": "permanently_discontinue",
          "components": [
            "whole_regimen"
          ],
          "message": "Grade 4 non-haematological toxicity: discontinue the affected treatment pathway."
        },
        "source": {
