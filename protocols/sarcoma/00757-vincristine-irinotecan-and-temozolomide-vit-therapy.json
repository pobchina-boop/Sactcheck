          "field": "ecog",
          "operator": ">",
          "value": 2
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "whole_regimen"
          ],
          "message": "ECOG above 2 is outside the usual source eligibility range; verify the indication and current NCCP regimen."
        },
        "source": {
