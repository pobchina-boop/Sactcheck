              "operator": "==",
              "value": true
            },
            {
              "field": "breastfeeding",
              "operator": "==",
              "value": true
            }
          ]
        },
        "action": {
          "type": "contraindicated",
          "components": [
            "whole_regimen"
          ],
          "message": "Pregnancy or breastfeeding is outside the routine source pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Eligibility/exclusions section"
        },
        "explanation": "Pregnancy or breastfeeding is outside the routine source pathway."
      },
      {
