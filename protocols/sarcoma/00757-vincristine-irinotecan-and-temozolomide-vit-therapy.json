        "priority": 9,
        "when": {
          "field": "age_years",
          "operator": ">",
          "value": 50
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "whole_regimen"
          ],
          "message": "Age >50 years is outside the routine source age range."
        },
        "source": {
          "document": "Current official NCCP regimen",
