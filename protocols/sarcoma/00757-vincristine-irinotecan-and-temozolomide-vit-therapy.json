        "id": "IRI_BILI_GT3",
        "priority": 10,
        "when": {
          "field": "bilirubin_uln_multiple",
          "operator": ">",
          "value": 3
        },
        "action": {
          "type": "contraindicated",
          "components": [
            "irinotecan"
          ],
          "message": "Bilirubin >3 ×ULN: irinotecan is contraindicated."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
