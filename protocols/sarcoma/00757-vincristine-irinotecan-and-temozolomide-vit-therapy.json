        "priority": 10,
        "when": {
          "field": "platelets_x10e9_l",
          "operator": "<",
          "value": 75
        },
        "action": {
          "type": "delay",
          "components": [
            "whole_regimen"
          ],
          "message": "Platelets <75 ×10⁹/L: delay according to the cycle/day source pathway."
