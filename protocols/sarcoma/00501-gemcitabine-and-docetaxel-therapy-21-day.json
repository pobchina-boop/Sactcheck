    "rules": [
      {
        "id": "ECOG_OUTSIDE_SOURCE_RANGE",
        "priority": 8,
        "when": {
          "field": "ecog",
          "operator": ">",
          "value": 2
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "whole_regimen"
          ],
          "message": "ECOG above 2 is outside the usual source eligibility range; verify the indication and current NCCP regimen."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Eligibility section"
        },
        "explanation": "ECOG above 2 is outside the usual source eligibility range; verify the indication and current NCCP regimen."
      },
      {
        "id": "HYPERSENSITIVITY",
        "priority": 10,
        "when": {
          "field": "hypersensitivity",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "contraindicated",
          "components": [
            "whole_regimen"
          ],
          "message": "Known hypersensitivity to a regimen component triggers the source exclusion pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Exclusions section"
        },
        "explanation": "Known hypersensitivity to a regimen component triggers the source exclusion pathway."
      },
      {
        "id": "PREGNANCY_BREASTFEEDING",
        "priority": 10,
        "when": {
          "any": [
            {
              "field": "pregnancy",
              "operator": "==",
              "value": true
            },
            {
              "field": "breastfeeding",
              "operator": "==",
              "value": true
            }
          ]
        },
        "action": {
          "type": "contraindicated",
          "components": [
            "whole_regimen"
          ],
          "message": "Pregnancy or breastfeeding is outside the routine source pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Eligibility/exclusions section"
        },
        "explanation": "Pregnancy or breastfeeding is outside the routine source pathway."
      },
      {
        "id": "DAY1_ANC",
        "priority": 10,
        "when": {
          "field": "anc_x10e9_l",
          "operator": "<",
          "value": 1
        },
        "action": {
          "type": "delay",
          "components": [
            "whole_regimen"
          ],
          "message": "Day 1: ANC <1.0 ×10⁹/L requires delay until recovery."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Day 1: ANC <1.0 ×10⁹/L requires delay until recovery."
      },
      {
        "id": "DAY1_PLT",
        "priority": 10,
        "when": {
          "field": "platelets_x10e9_l",
          "operator": "<",
          "value": 100
        },
        "action": {
          "type": "delay",
          "components": [
            "whole_regimen"
          ],
          "message": "Day 1: platelets <100 ×10⁹/L require delay until recovery."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Day 1: platelets <100 ×10⁹/L require delay until recovery."
      },
      {
        "id": "DAY8_ANC",
        "priority": 10,
        "when": {
          "field": "anc_x10e9_l",
          "operator": "<",
          "value": 1
        },
        "action": {
          "type": "delay",
          "components": [
            "whole_regimen"
          ],
          "message": "Day 8: ANC <1.0 ×10⁹/L requires deferral to Day 15; subsequent doses follow the source reduction pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Day 8: ANC <1.0 ×10⁹/L requires deferral to Day 15; subsequent doses follow the source reduction pathway."
      },
      {
        "id": "DAY8_PLT",
        "priority": 10,
        "when": {
          "field": "platelets_x10e9_l",
          "operator": "<",
          "value": 75
        },
        "action": {
          "type": "delay",
          "components": [
            "whole_regimen"
          ],
          "message": "Day 8: platelets <75 ×10⁹/L require deferral to Day 15; subsequent doses follow the source reduction pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Day 8: platelets <75 ×10⁹/L require deferral to Day 15; subsequent doses follow the source reduction pathway."
      },
      {
        "id": "FN_FIRST",
        "priority": 10,
        "when": {
          "field": "febrile_neutropenia",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "withhold",
          "components": [
            "whole_regimen"
          ],
          "message": "Febrile neutropenia: withhold the remainder of the cycle and consider G-CSF."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Febrile neutropenia: withhold the remainder of the cycle and consider G-CSF."
      },
      {
        "id": "FN_SECOND",
        "priority": 9,
        "when": {
          "field": "second_febrile_neutropenia_occurrence",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "dose_reduce_one_level",
          "components": [
            "whole_regimen"
          ],
          "message": "Second febrile-neutropenia occurrence: reduce regimen by one dose level."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Second febrile-neutropenia occurrence: reduce regimen by one dose level."
      },
      {
        "id": "DOC_HEPATIC_NOT_REC",
        "priority": 10,
        "when": {
          "field": "bilirubin_actual_umol_l",
          "operator": ">",
          "value": 30
        },
        "action": {
          "type": "contraindicated",
          "components": [
            "docetaxel"
          ],
          "message": "Bilirubin >1.5 ×ULN: docetaxel is not recommended in the routine pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Bilirubin >1.5 ×ULN: docetaxel is not recommended in the routine pathway."
      },
      {
        "id": "DOC_HEPATIC_50",
        "priority": 9,
        "when": {
          "field": "alt_ast_uln_multiple",
          "operator": ">",
          "value": 5
        },
        "action": {
          "type": "dose_reduce",
          "components": [
            "docetaxel"
          ],
          "message": "Marked transaminase elevation: consider 50% docetaxel only within the source hepatic table and consultant review."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Marked transaminase elevation: consider 50% docetaxel only within the source hepatic table and consultant review."
      },
      {
        "id": "GEM_BILI_27",
        "priority": 8,
        "when": {
          "field": "bilirubin_actual_umol_l",
          "operator": ">=",
          "value": 27
        },
        "action": {
          "type": "dose_reduce",
          "components": [
            "gemcitabine"
          ],
          "message": "Bilirubin ≥27 µmol/L: consider starting gemcitabine at 80% with close monitoring."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Bilirubin ≥27 µmol/L: consider starting gemcitabine at 80% with close monitoring."
      },
      {
        "id": "NEURO_G2",
        "priority": 9,
        "when": {
          "field": "neuropathy_grade",
          "operator": ">=",
          "value": 2
        },
        "action": {
          "type": "consultant_review",
          "components": [
            "docetaxel"
          ],
          "message": "Grade ≥2 neuropathy requires docetaxel dose modification/omission review."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Grade ≥2 neuropathy requires docetaxel dose modification/omission review."
      },
      {
        "id": "NONHAEM_G3",
        "priority": 9,
        "when": {
          "field": "other_nonhaem_toxicity_grade",
          "operator": ">=",
          "value": 3
        },
        "action": {
          "type": "withhold_then_reduce",
          "components": [
            "whole_regimen"
          ],
          "message": "Grade ≥3 non-haematological toxicity: withhold until recovery and apply the source dose-reduction pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Grade ≥3 non-haematological toxicity: withhold until recovery and apply the source dose-reduction pathway."
      }
    ]
