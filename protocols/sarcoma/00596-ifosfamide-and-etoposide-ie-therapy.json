        },
        "explanation": "ECOG above 2 is outside the usual source eligibility range; verify the indication and current NCCP regimen."
      },
      {
        "id": "HYPERSENSITIVITY",
        "priority": 10,
        "when": {
          "field": "hypersensitivity",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "contraindicated",
          "components": [
            "whole_regimen"
          ],
          "message": "Known hypersensitivity to a regimen component triggers the source exclusion pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Exclusions section"
        },
        "explanation": "Known hypersensitivity to a regimen component triggers the source exclusion pathway."
      },
      {
        "id": "PREGNANCY_BREASTFEEDING",
        "priority": 10,
        "when": {
          "any": [
            {
              "field": "pregnancy",
              "operator": "==",
              "value": true
            },
            {
              "field": "breastfeeding",
              "operator": "==",
              "value": true
            }
          ]
        },
        "action": {
          "type": "contraindicated",
          "components": [
            "whole_regimen"
          ],
          "message": "Pregnancy or breastfeeding is outside the routine source pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Eligibility/exclusions section"
        },
        "explanation": "Pregnancy or breastfeeding is outside the routine source pathway."
      },
      {
        "id": "ANC_LT075",
        "priority": 10,
        "when": {
          "field": "anc_x10e9_l",
          "operator": "<",
          "value": 0.75
        },
        "action": {
          "type": "delay",
          "components": [
            "whole_regimen"
          ],
          "message": "ANC <0.75 ×10⁹/L: delay one week."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "ANC <0.75 ×10⁹/L: delay one week."
      },
      {
        "id": "PLT_LT100",
        "priority": 10,
        "when": {
          "field": "platelets_x10e9_l",
          "operator": "<",
          "value": 100
        },
        "action": {
          "type": "delay",
          "components": [
            "whole_regimen"
          ],
          "message": "Platelets <100 ×10⁹/L: delay one week."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "Platelets <100 ×10⁹/L: delay one week."
      },
      {
        "id": "LATE_RECOVERY",
        "priority": 9,
        "when": {
          "field": "recovery_delay_beyond_protocol_day",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "dose_reduce",
          "components": [
            "whole_regimen"
          ],
          "message": "If counts have not recovered by the protocol-defined latest day, reduce subsequent doses by 20%."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Dose modification section"
        },
        "explanation": "If counts have not recovered by the protocol-defined latest day, reduce subsequent doses by 20%."
      },
      {
        "id": "ETO_CRCL_10_50",
