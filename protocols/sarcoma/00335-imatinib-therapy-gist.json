      {
        "id": "HYPERSENSITIVITY",
        "priority": 10,
        "when": {
          "field": "hypersensitivity",
          "operator": "==",
          "value": true
        },
        "action": {
          "type": "contraindicated",
          "components": [
            "whole_regimen"
          ],
          "message": "Known hypersensitivity to a regimen component triggers the source exclusion pathway."
        },
        "source": {
          "document": "Current official NCCP regimen",
          "page": "Exclusions section"
        },
        "explanation": "Known hypersensitivity to a regimen component triggers the source exclusion pathway."
      },
      {
