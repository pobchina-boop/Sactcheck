          "type": "consultant_review",
          "components": [
            "enzalutamide"
          ],
          "message": "Confirm the cause, highest severity, recovery and previous dose. Recovery alone does not authorise a restart. Source: interrupt for 7 days or until ≤grade 2; clinician chooses 160, 120 or 80 mg/day. Do not restart with ongoing intolerable/severe toxicity.",
          "dose_calculation": "specialist_review"
        },
        "source": {
          "document": "NCCP 00233 v7",
          "page": "Dose modifications",
          "url": "https://healthservice.hse.ie/documents/6332/233_v7_Enzalutamide_Monotherapy.pdf"
