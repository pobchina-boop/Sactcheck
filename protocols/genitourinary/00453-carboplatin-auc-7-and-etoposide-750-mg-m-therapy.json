  "treatment": {
    "cycle_length_days": 28,
    "schedule_summary": "Carboplatin AUC7 then etoposide 750 mg/m² on days −5, −4 and −3; stem cells day 0; G-CSF from day +1.",
    "drugs": [
      "carboplatin",
      "etoposide"
    ],
    "duration_text": "One high-dose course; possible second course after recovery, at least 28 days later.",
    "duration_type": "specialist_course",
    "administration": [
      {
        "drug": "carboplatin",
        "dose_text": "AUC7",
        "route": "IV",
        "days": [
          -5,
          -4,
          -3
        ],
        "note": "Over 30 minutes. Source Calvert formula, GFR cap 125 mL/min; specialist transplant prescription."
      },
      {
        "drug": "etoposide",
        "dose_text": "750 mg/m²",
        "route": "IV",
        "days": [
          -5,
          -4,
          -3
        ],
        "note": "Over 2 hours. Autologous stem cells day 0; G-CSF from day+1 until ANC>1 on2 consecutive days."
      }
    ],
    "calendar_origin": "autologous_stem_cell_infusion_day0",
    "not_automatic_repeating_cycle": true
  },
