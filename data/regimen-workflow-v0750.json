          "frequency": "OD",
          "timing": "Days 2-4"
        },
        {
          "medicine": "Metoclopramide",
          "dose": "10 mg",
          "route": "PO",
          "frequency": "TDS",
          "timing": "Subsequent days / as directed"
        },
        {
          "medicine": "Olanzapine",
          "dose": "5 mg",
          "route": "PO",
          "frequency": "OD",
          "timing": "Days 2-4"
        }
      ],
      "warnings": [
        "Caution: metoclopramide with olanzapine may increase extrapyramidal adverse effects.",
        "Dexamethasone may be modified or omitted where the SACT regimen already includes a steroid."
      ],
      "local_prescription_source_id": "cuh_high_emetogenic_v2_2021",
      "local_prescription_items": [
        {
          "medicine": "Aprepitant",
          "dose": "125 mg",
          "route": "PO",
          "frequency": "OD",
          "timing": "Day 1",
          "directions": "Take one capsule one hour prior to chemotherapy; bring it to the day ward."
        },
        {
          "medicine": "Aprepitant",
          "dose": "80 mg",
          "route": "PO",
          "frequency": "OD",
          "timing": "Days 2-3",
          "directions": "Take one capsule daily for two days starting the day after chemotherapy."
        },
        {
          "medicine": "Dexamethasone",
          "dose": "8 mg",
          "route": "PO",
          "frequency": "OD",
          "timing": "Days 2-4",
          "directions": "Take once daily for three days starting the day after chemotherapy."
        },
        {
          "medicine": "Omeprazole",
          "dose": "20 mg",
          "route": "PO",
          "frequency": "OD",
          "timing": "Days 1-4",
          "directions": "Take one capsule daily for four days starting on the day of chemotherapy."
        },
        {
          "medicine": "Nystatin",
          "dose": "100,000 units/mL, 1 mL",
          "route": "PO",
          "frequency": "QDS",
          "timing": "Continuous during chemotherapy",
          "directions": "Rinse 1 mL around the mouth four times daily after meals during the chemotherapy regimen."
        },
        {
          "medicine": "Chlorhexidine mouthwash",
          "dose": "10 mL",
          "route": "PO",
          "frequency": "QDS",
          "timing": "Continuous during chemotherapy",
          "directions": "Rinse 10 mL around the mouth for at least 1 minute four times daily; expel after rinsing."
        },
        {
          "medicine": "Cyclizine",
          "dose": "50 mg",
          "route": "PO",
          "frequency": "TDS PRN",
          "timing": "As required during chemotherapy",
          "directions": "Take one tablet three times daily as required."
        },
        {
          "medicine": "Metoclopramide",
          "dose": "10 mg",
          "route": "PO",
          "frequency": "TDS PRN",
          "timing": "As required during chemotherapy",
          "directions": "Take one tablet three times daily as required."
        },
        {
          "medicine": "Loperamide",
          "dose": "4 mg STAT, then 2 mg",
          "route": "PO",
          "frequency": "QDS PRN",
          "timing": "Chemotherapy-induced diarrhoea; max 16 mg/day",
          "directions": "Take 4 mg after the first episode of diarrhoea, then 2 mg after each further episode, to a maximum of 16 mg/day."
        }
      ]
    },
