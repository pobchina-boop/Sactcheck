  "interaction_rules": [
    {
      "id": "erlotinib_acid_suppression",
      "match_agents": [
        "erlotinib"
      ],
      "category": "supportive_care_interaction",
      "severity": "important",
      "action": "avoid_routine_ppi",
      "message": "Avoid routine proton-pump inhibitor co-administration with erlotinib. Omeprazole reduced erlotinib AUC by 46% and Cmax by 61% in the SmPC interaction study. If acid suppression is essential, review the current SmPC and oncology-pharmacy advice rather than automatically substituting another acid-suppressing medicine.",
      "source_id": "erlotinib_smpc"
    }
  ],
