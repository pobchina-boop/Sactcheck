      "vesicant_dna": {
        "label": "Vesicant - DNA binding",
        "severity": 4,
        "colour": "red",
        "general_action": "Localise and neutralise; cold compress is generally used. Apply drug-specific antidote guidance and local policy."
      },
      "vesicant_non_dna": {
        "label": "Vesicant - non-DNA binding",
        "severity": 4,
        "colour": "amber",
        "general_action": "Disperse and dilute; warm compress is generally used. Apply drug-specific antidote guidance and local policy."
      },
      "irritant": {
