    "00568": {
      "patient_summary": {
        "purpose": "Chemotherapy and immunotherapy to help control lung cancer. Your team explains the expected benefits and the choices for you.",
        "schedule": "Treatment is usually on Day 1 of a 21-day cycle: once every 3 weeks. Your team confirms each visit after checking your blood tests and symptoms.",
        "phases": [
          {
            "title": "First part: up to 4 cycles",
            "text": "Pembrolizumab, pemetrexed and carboplatin together. Each cycle lasts 3 weeks."
          },
          {
            "title": "Review and ongoing treatment",
            "text": "Carboplatin stops. Pembrolizumab and pemetrexed may continue. Your team reviews how treatment is working and how you are feeling."
          }
        ],
        "preparation": [
          "Take the prescribed folic acid and attend for vitamin B12 injections. These help protect you during pemetrexed treatment.",
          "Follow your written anti-sickness and steroid plan. Ask the team to check the steroid instructions if you have more than one prescription.",
          "Have the arranged blood tests and report new symptoms before each visit. Keep your immunotherapy alert card with you."
        ],
        "card_schedule": "Usually Day 1, every 3 weeks. Carboplatin stops after up to 4 cycles.",
        "card_alert": "Includes immunotherapy: new symptoms can occur during treatment or after it ends. Tell any clinician you receive pembrolizumab."
      }
    },
