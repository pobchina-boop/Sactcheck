    "00271": {
      "patient_summary": {
        "purpose": "These two chemotherapy medicines aim to control the cancer. Your team will explain the expected benefit for you.",
        "schedule": "Carboplatin is given on Day 1. Etoposide is given on Days 1–3. A cycle lasts 21 days (3 weeks); the team checks you before the next cycle.",
        "phases": [
          {
            "title": "Before starting",
            "text": "Blood tests and a review of your health. Confirm your three treatment days and whether etoposide is by drip or capsules."
          },
          {
            "title": "Treatment and time at home",
            "text": "Both medicines on Day 1; etoposide continues on Days 2–3. Follow your medicines plan at home."
          },
          {
            "title": "Review and next steps",
            "text": "Usually 4–6 cycles. Your team may delay, reduce or stop treatment after reviewing your health and response."
          }
        ],
        "preparation": [
          "Confirm whether Days 2–3 etoposide will be drips or prescribed capsules.",
          "Ask for a written anti-sickness plan covering every treatment day and the following days.",
          "Bring your medicines list and report hearing problems, numbness or signs of infection."
        ],
        "card_schedule": "Day 1 platinum; etoposide Days 1–3. Repeat every 3 weeks.",
        "card_alert": "I am receiving chemotherapy. Infection can be serious even without a fever. Contact my oncology team promptly if I become unwell."
      }
